{
  "name": "fundacion-payande",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web estático (solo frontend) de la Fundación Payandé.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prune-assets.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "images": "node scripts/optimize-images.mjs",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/kaushan-script": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "playwright-core": "^1.56.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
