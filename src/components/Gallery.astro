---
import { Picture, getImage } from 'astro:assets';
import { categoryLabels, type Photo, type PhotoCategory } from '../data/photos.ts';

interface Props {
  photos: readonly Photo[];
  filterable?: boolean;
  /** Identificador único cuando hay más de una galería en la página. */
  id?: string;
}

const { photos, filterable = false, id = 'galeria' } = Astro.props;

// Versión ampliada para el visor: WebP de 1600px (los navegadores objetivo soportan WebP).
const items = await Promise.all(
  photos.map(async (photo) => {
    const large = await getImage({ src: photo.src, width: 1600, format: 'webp', quality: 72 });
    return { ...photo, largeSrc: large.src, largeWidth: large.attributes.width, largeHeight: large.attributes.height };
  }),
);

const categories = [...new Set(photos.map((p) => p.category))] as PhotoCategory[];
---

<div class="gallery" data-gallery id={id}>
  {
    filterable && (
      <div class="gallery__filters" role="group" aria-label="Filtrar fotos por programa">
        <button type="button" class="chip" aria-pressed="true" data-filter="todas">
          Todas
        </button>
        {categories.map((category) => (
          <button type="button" class="chip" aria-pressed="false" data-filter={category}>
            {categoryLabels[category]}
          </button>
        ))}
      </div>
    )
  }
  {filterable && <p class="gallery__status" aria-live="polite" data-gallery-status>{`Mostrando ${photos.length} fotos.`}</p>}

  <ul class="gallery__grid" role="list">
    {
      items.map((item, index) => (
        <li class="gallery__item" data-category={item.category} data-reveal style={`--stagger:${index % 6}`}>
          <a
            class="gallery__link"
            href={item.largeSrc}
            data-index={index}
            data-large={item.largeSrc}
            data-width={item.largeWidth}
            data-height={item.largeHeight}
            data-caption={item.alt}
            aria-label={`${categoryLabels[item.category]}. Ampliar foto: ${item.alt}`}
          >
            <Picture
              src={item.src}
              alt={item.alt}
              formats={['avif', 'webp']}
              width={560}
              height={420}
              fit="cover"
              sizes="(min-width: 72rem) 18rem, (min-width: 40rem) 30vw, 46vw"
              class="gallery__img"
            />
            <span class="gallery__caption">{categoryLabels[item.category]}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Visor de fotos" data-lightbox>
    <div class="lightbox__frame">
      <img class="lightbox__img" alt="" data-lightbox-img />
      <p class="lightbox__caption" data-lightbox-caption></p>
    </div>
    <p class="lightbox__counter" data-lightbox-counter></p>
    <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close aria-label="Cerrar visor">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
    </button>
    <button class="lightbox__btn lightbox__prev" type="button" data-lightbox-prev aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button class="lightbox__btn lightbox__next" type="button" data-lightbox-next aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </dialog>
</div>

<script>
  import { initGallery } from '../scripts/gallery.ts';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

<style>
  .gallery__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .chip {
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--color-text);
    font-weight: 500;
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--verde-700);
  }

  .chip[aria-pressed='true'] {
    background: var(--verde-700);
    border-color: var(--verde-700);
    color: #fff;
  }

  .gallery__status {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-5);
  }

  .gallery__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .gallery__grid {
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      gap: var(--space-4);
    }
  }

  .gallery__item[hidden] {
    display: none;
  }

  .gallery__link {
    position: relative;
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--verde-100);
  }

  .gallery__link :global(picture) {
    height: 100%;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .gallery__link:hover .gallery__img,
  .gallery__link:focus-visible .gallery__img {
    transform: scale(1.06);
  }

  .gallery__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-6) var(--space-3) var(--space-3);
    background: linear-gradient(0deg, rgb(15 59 46 / 0.85), transparent);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 500;
    transform: translateY(100%);
    transition: transform 400ms var(--ease-out);
  }

  .gallery__link:hover .gallery__caption,
  .gallery__link:focus-visible .gallery__caption {
    transform: none;
  }

  @media (hover: none) {
    .gallery__caption {
      transform: none;
    }
  }

  /* Visor: la foto entra con un leve zoom */
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__frame {
      animation: lb-in 450ms var(--ease-out);
    }

    .lightbox[open]::backdrop {
      animation: lb-fade 300ms ease;
    }
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  /* ---------- Visor ---------- */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-8) var(--space-4) var(--space-6);
    border: 0;
    background: rgb(8 28 22 / 0.96);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(8 28 22 / 0.8);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox__frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(100%, 72rem);
    max-height: 100%;
    margin: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 11rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .lightbox__caption {
    margin: var(--space-3) 0 0;
    max-width: 48rem;
    text-align: center;
  }

  .lightbox__counter {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    margin: 0;
    font-size: var(--fs-sm);
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background: rgb(15 59 46 / 0.7);
    color: #fff;
    cursor: pointer;
  }

  .lightbox__btn:hover {
    background: var(--verde-700);
  }

  .lightbox :focus-visible {
    outline-color: #fff;
  }

  .lightbox__close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: var(--space-3);
  }

  .lightbox__next {
    right: var(--space-3);
  }

  @media (max-width: 40rem) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: var(--space-3);
      transform: none;
    }

    .lightbox {
      padding-bottom: var(--space-9);
    }
  }
</style>
