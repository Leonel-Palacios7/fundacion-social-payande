---
import RandomPicture from './RandomPicture.astro';
import { renderLarge } from '../lib/shapes.ts';
import { categoryLabels, type Photo, type PhotoCategory } from '../data/photos.ts';

interface Props {
  photos: readonly Photo[];
  filterable?: boolean;
  /** Identificador único cuando hay más de una galería en la página. */
  id?: string;
  /** Mosaico estilo Pinterest: cada foto con su proporción original. */
  masonry?: boolean;
}

const { photos, filterable = false, id = 'galeria', masonry = false } = Astro.props;

// Versión ampliada para el visor: WebP de 1600px (los navegadores objetivo soportan WebP).
const items = await Promise.all(
  photos.map(async (photo) => {
    const large = await renderLarge(photo);
    return { ...photo, largeSrc: large.src, largeWidth: large.width, largeHeight: large.height };
  }),
);

const categories = [...new Set(photos.map((p) => p.category))] as PhotoCategory[];
const countOf = (category: PhotoCategory) => photos.filter((p) => p.category === category).length;

/** Íconos pequeños de cada filtro (trazos de 24×24). */
const filterIcons: Record<PhotoCategory | 'todas', string> = {
  todas: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  educacion: '<path d="M3 6.5c3-1.5 6-1.5 9 .5 3-2 6-2 9-.5V19c-3-1.5-6-1.5-9 .5-3-2-6-2-9-.5z"/><path d="M12 7v12.5"/>',
  ninez: '<path d="M12 3a5 5 0 0 1 5 5c0 3.5-3 6-5 6s-5-2.5-5-6a5 5 0 0 1 5-5z"/><path d="M12 14l-1 2h2l-1-2M12 16c0 2 1.5 3 0 5"/>',
  vivienda: '<path d="M3 11 12 4l9 7"/><path d="M5 9.5V20h14V9.5"/><path d="M10 20v-5h4v5"/>',
  jovenes: '<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17M3.5 12h17M6 6c3 3 3 9 0 12M18 6c-3 3-3 9 0 12"/>',
  salud: '<path d="M12 20.5S3 15 3 8.8a4.8 4.8 0 0 1 9-2.4 4.8 4.8 0 0 1 9 2.4C21 15 12 20.5 12 20.5z"/><path d="M12 9v5M9.5 11.5h5"/>',
  comunidad: '<circle cx="8" cy="8" r="3"/><circle cx="16.5" cy="9" r="2.5"/><path d="M2.5 20v-1.5a5.5 5.5 0 0 1 11 0V20M13.5 14.2a4.5 4.5 0 0 1 8 3V20"/>',
};
---

<div class="gallery" data-gallery data-shuffle={filterable ? '' : undefined} id={id}>
  {
    filterable && (
      <div class="gallery__filters" role="group" aria-label="Filtrar fotos por programa" data-filters>
        <span class="gallery__pill" aria-hidden="true" data-filter-pill></span>
        <button type="button" class="chip" aria-pressed="true" data-filter="todas">
          <svg class="chip__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={filterIcons.todas} />
          Todas
          <span class="chip__count" aria-hidden="true">{photos.length}</span>
        </button>
        {categories.map((category) => (
          <button type="button" class="chip" aria-pressed="false" data-filter={category}>
            <svg class="chip__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={filterIcons[category]} />
            {categoryLabels[category]}
            <span class="chip__count" aria-hidden="true">{countOf(category)}</span>
          </button>
        ))}
      </div>
    )
  }
  {filterable && <p class="gallery__status" aria-live="polite" data-gallery-status>{`Mostrando ${photos.length} fotos.`}</p>}

  <ul class:list={['gallery__grid', { 'gallery__grid--masonry': masonry }]} role="list">
    {
      items.map((item, index) => (
        <li class="gallery__item" data-category={item.category} data-reveal style={`--stagger:${index % (masonry ? 4 : 6)}`}>
          <a
            class="gallery__link"
            href={item.largeSrc}
            data-index={index}
            data-large={item.largeSrc}
            data-width={item.largeWidth}
            data-height={item.largeHeight}
            data-caption={item.alt}
            aria-label={`${categoryLabels[item.category]}. Ampliar foto: ${item.alt}`}
          >
            <RandomPicture
              photo={item}
              shape={masonry ? 'natural' : 'landscape'}
              sizes={masonry ? '(min-width: 72rem) 17rem, (min-width: 64rem) 23vw, (min-width: 40rem) 31vw, 46vw' : '(min-width: 72rem) 18rem, (min-width: 40rem) 30vw, 46vw'}
              random={!filterable}
              class="gallery__img"
            />
            <span class="gallery__caption">{categoryLabels[item.category]}</span>
            {masonry && (
              <span class="gallery__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M16 16l4.5 4.5M11 8.5v5M8.5 11h5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Visor de fotos" data-lightbox>
    <div class="lightbox__frame">
      <img class="lightbox__img" alt="" data-lightbox-img />
      <p class="lightbox__caption" data-lightbox-caption></p>
    </div>
    <p class="lightbox__counter" data-lightbox-counter></p>
    <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close aria-label="Cerrar visor">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
    </button>
    <button class="lightbox__btn lightbox__prev" type="button" data-lightbox-prev aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button class="lightbox__btn lightbox__next" type="button" data-lightbox-next aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </dialog>
</div>

<script>
  import { initGallery } from '../scripts/gallery.ts';
  import { shuffleGallery } from '../scripts/random-photos.ts';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    // La galería completa aparece en un orden distinto en cada visita.
    if (gallery.hasAttribute('data-shuffle')) shuffleGallery(gallery);
    initGallery(gallery);
  });
</script>

<style>
  /* ---------- Filtros: una píldora se desliza hasta el filtro elegido ---------- */
  .gallery__filters {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding: var(--space-2);
    border-radius: 1.75rem;
    background: var(--tint-50);
  }

  @media (max-width: 40rem) {
    /* En móvil los filtros se deslizan de lado en una sola fila. */
    .gallery__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .gallery__filters::-webkit-scrollbar {
      display: none;
    }

    .chip {
      flex: none;
      scroll-snap-align: center;
    }
  }

  .gallery__pill {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    display: none;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--verde-700), var(--turquesa-700));
    box-shadow: 0 8px 20px -8px rgb(15 59 46 / 0.6);
    pointer-events: none;
  }

  .gallery__filters.has-pill .gallery__pill {
    display: block;
    transition:
      transform 0.55s var(--ease-out),
      width 0.55s var(--ease-out),
      height 0.55s var(--ease-out);
  }

  .chip {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.4rem 0.6rem 0.4rem 0.9rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: var(--color-card);
    color: var(--color-text);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.35s var(--ease),
      background-color 0.35s var(--ease),
      transform 0.35s var(--ease-out),
      border-color 0.35s var(--ease);
  }

  .chip:hover {
    border-color: var(--ink-accent);
    transform: translateY(-2px);
  }

  .chip:active {
    transform: scale(0.95);
  }

  .chip[aria-pressed='true'] {
    background: var(--verde-700);
    color: #fff;
  }

  /* Con la píldora animada, el botón activo se vuelve transparente encima de ella. */
  .has-pill .chip[aria-pressed='true'] {
    background: transparent;
    border-color: transparent;
  }

  .chip__icon {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.45s var(--ease-out);
  }

  .chip:hover .chip__icon,
  .chip[aria-pressed='true'] .chip__icon {
    transform: rotate(-10deg) scale(1.15);
  }

  .chip__count {
    display: grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--tint-100);
    color: var(--ink-strong);
    font-size: 0.8rem;
    font-weight: 700;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .chip[aria-pressed='true'] .chip__count {
    background: var(--color-card);
    color: var(--ink-strong);
  }

  /* Las fotos que quedan al filtrar entran una tras otra. */
  @media (prefers-reduced-motion: no-preference) {
    .gallery__item.is-entering {
      animation: item-in 0.6s var(--ease-out) backwards;
      animation-delay: calc(var(--order, 0) * 45ms);
    }

    .chip.is-bumping .chip__count {
      animation: count-bump 0.5s var(--ease-out);
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.92);
    }
  }

  @keyframes count-bump {
    40% {
      transform: scale(1.35);
    }
  }

  .gallery__status {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-5);
  }

  .gallery__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .gallery__grid {
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      gap: var(--space-4);
    }
  }

  /* ---------- Mosaico estilo Pinterest ---------- */
  .gallery__grid--masonry {
    display: block;
    columns: 2;
    column-gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .gallery__grid--masonry {
      columns: 3;
      column-gap: var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .gallery__grid--masonry {
      columns: 4;
    }
  }

  .gallery__grid--masonry .gallery__item {
    break-inside: avoid;
    margin-bottom: var(--space-3);
  }

  @media (min-width: 40rem) {
    .gallery__grid--masonry .gallery__item {
      margin-bottom: var(--space-4);
    }
  }

  .gallery__grid--masonry .gallery__link {
    aspect-ratio: auto;
    border-radius: 1.25rem;
    box-shadow: 0 1px 2px rgb(15 59 46 / 0.08);
    transition:
      transform 450ms var(--ease-out),
      box-shadow 450ms var(--ease-out);
  }

  .gallery__grid--masonry .gallery__img {
    height: auto;
  }

  /* Velo oscuro que aparece al pasar el cursor, como en Pinterest. */
  .gallery__grid--masonry .gallery__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(8 28 22 / 0.28);
    opacity: 0;
    transition: opacity 350ms ease;
  }

  .gallery__grid--masonry .gallery__caption {
    z-index: 1;
  }

  .gallery__zoom {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-card);
    color: var(--ink-strong);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.2);
    opacity: 0;
    transform: scale(0.6) rotate(-45deg);
    transition:
      opacity 300ms ease,
      transform 450ms var(--ease-out);
  }

  .gallery__grid--masonry .gallery__link:hover,
  .gallery__grid--masonry .gallery__link:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 18px 36px -12px rgb(15 59 46 / 0.45);
  }

  .gallery__grid--masonry .gallery__link:hover::after,
  .gallery__grid--masonry .gallery__link:focus-visible::after,
  .gallery__link:hover .gallery__zoom,
  .gallery__link:focus-visible .gallery__zoom {
    opacity: 1;
  }

  .gallery__link:hover .gallery__zoom,
  .gallery__link:focus-visible .gallery__zoom {
    transform: none;
  }

  /* Las fotos del mosaico entran creciendo, una tras otra. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .gallery__grid--masonry .gallery__item[data-reveal] {
      transform: translateY(48px) scale(0.9);
      transition-duration: 1s;
    }

    :global(.js) .gallery__grid--masonry .gallery__item[data-reveal]:global(.is-visible) {
      transform: none;
    }
  }

  .gallery__item[hidden] {
    display: none;
  }

  .gallery__link {
    position: relative;
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--tint-100);
  }

  .gallery__link :global(picture) {
    height: 100%;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .gallery__link:hover .gallery__img,
  .gallery__link:focus-visible .gallery__img {
    transform: scale(1.06);
  }

  .gallery__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-6) var(--space-3) var(--space-3);
    background: linear-gradient(0deg, rgb(15 59 46 / 0.85), transparent);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 500;
    transform: translateY(100%);
    transition: transform 400ms var(--ease-out);
  }

  .gallery__link:hover .gallery__caption,
  .gallery__link:focus-visible .gallery__caption {
    transform: none;
  }

  @media (hover: none) {
    .gallery__caption {
      transform: none;
    }
  }

  /* Visor: la foto entra con un leve zoom */
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__frame {
      animation: lb-in 450ms var(--ease-out);
    }

    .lightbox[open]::backdrop {
      animation: lb-fade 300ms ease;
    }
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  /* ---------- Visor ---------- */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-8) var(--space-4) var(--space-6);
    border: 0;
    background: rgb(8 28 22 / 0.96);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(8 28 22 / 0.8);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox__frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(100%, 72rem);
    max-height: 100%;
    margin: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 11rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .lightbox__caption {
    margin: var(--space-3) 0 0;
    max-width: 48rem;
    text-align: center;
  }

  .lightbox__counter {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    margin: 0;
    font-size: var(--fs-sm);
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background: rgb(15 59 46 / 0.7);
    color: #fff;
    cursor: pointer;
  }

  .lightbox__btn:hover {
    background: var(--verde-700);
  }

  .lightbox :focus-visible {
    outline-color: #fff;
  }

  .lightbox__close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: var(--space-3);
  }

  .lightbox__next {
    right: var(--space-3);
  }

  @media (max-width: 40rem) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: var(--space-3);
      transform: none;
    }

    .lightbox {
      padding-bottom: var(--space-9);
    }
  }
</style>
