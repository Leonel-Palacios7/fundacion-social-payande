---
import { LIMITS, MOTIVOS } from '../scripts/contact-validation.ts';
import { site } from '../data/site.ts';
---

<form
  class="contact-form"
  novalidate
  data-contact-form
  data-to={site.contact.email}
  data-endpoint={site.contact.formEndpoint}
>
  <p class="contact-form__intro">
    Los campos marcados con <span aria-hidden="true">*</span><span class="visually-hidden">asterisco</span> son
    obligatorios. Tu mensaje llega directamente al correo de la Fundación.
  </p>

  <!-- Trampa para robots: las personas no ven este campo. -->
  <div class="contact-form__trap" aria-hidden="true">
    <label for="sitio-web">No llenes este campo</label>
    <input id="sitio-web" name="_honey" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form-summary" role="alert" tabindex="-1" hidden data-error-summary>
    <h2 class="form-summary__title">Revisa los siguientes campos</h2>
    <ul data-error-list></ul>
  </div>

  <div class="field">
    <label for="nombre">Nombre completo <span aria-hidden="true">*</span></label>
    <input id="nombre" name="nombre" type="text" autocomplete="name" required maxlength={LIMITS.nombreMax} aria-describedby="nombre-error" />
    <p class="field__error" id="nombre-error" data-error-for="nombre"></p>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="correo">Correo electrónico <span aria-hidden="true">*</span></label>
      <input id="correo" name="correo" type="email" autocomplete="email" inputmode="email" required aria-describedby="correo-error" />
      <p class="field__error" id="correo-error" data-error-for="correo"></p>
    </div>
    <div class="field">
      <label for="telefono">Teléfono <span class="field__optional">(opcional)</span></label>
      <input id="telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="telefono-error" />
      <p class="field__error" id="telefono-error" data-error-for="telefono"></p>
    </div>
  </div>

  <div class="field">
    <label for="motivo">Motivo <span aria-hidden="true">*</span></label>
    <select id="motivo" name="motivo" required aria-describedby="motivo-error">
      <option value="">Selecciona una opción</option>
      {MOTIVOS.map((m) => <option value={m}>{m}</option>)}
    </select>
    <p class="field__error" id="motivo-error" data-error-for="motivo"></p>
  </div>

  <div class="field">
    <label for="mensaje">Mensaje <span aria-hidden="true">*</span></label>
    <textarea id="mensaje" name="mensaje" rows="6" required maxlength={LIMITS.mensajeMax} aria-describedby="mensaje-ayuda mensaje-error"></textarea>
    <p class="field__hint" id="mensaje-ayuda" data-counter>Máximo {LIMITS.mensajeMax} caracteres.</p>
    <p class="field__error" id="mensaje-error" data-error-for="mensaje"></p>
  </div>

  <div class="field field--check">
    <input id="consentimiento" name="consentimiento" type="checkbox" required aria-describedby="consentimiento-error" />
    <label for="consentimiento">
      Autorizo a la Fundación Social Payandé a usar mis datos solo para responder este mensaje, conforme a la Ley 1581 de 2012.
      <span aria-hidden="true">*</span>
    </label>
    <p class="field__error" id="consentimiento-error" data-error-for="consentimiento"></p>
  </div>

  <div class="contact-form__actions">
    <button class="btn btn--primary contact-form__submit" type="submit" data-submit>
      <span class="contact-form__spinner" aria-hidden="true"></span>
      <span data-submit-label>Enviar mensaje</span>
      <svg class="contact-form__plane" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 3 3 10.5l7 2.5 2.5 7z M10 13l5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path></svg>
    </button>
  </div>

  <div class="form-sent" role="status" tabindex="-1" hidden data-sent>
    <svg class="form-sent__check" viewBox="0 0 52 52" aria-hidden="true">
      <circle cx="26" cy="26" r="24" pathLength="1"></circle>
      <path d="M15 27l7 7 15-16" pathLength="1"></path>
    </svg>
    <div>
      <p class="form-sent__title"><strong>¡Gracias! Tu mensaje fue enviado.</strong></p>
      <p>Te responderemos pronto al correo que nos dejaste.</p>
      <button class="btn btn--outline" type="button" data-new-message>Escribir otro mensaje</button>
    </div>
  </div>

  <div class="form-result" role="status" tabindex="-1" hidden data-result>
    <p class="form-result__title"><strong>No pudimos enviar el mensaje desde aquí.</strong></p>
    <p>
      Puedes enviarlo desde tu aplicación de correo con el mensaje ya escrito, o copiarlo y mandarlo a
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
    </p>
    <div class="btn-row">
      <a class="btn btn--outline" href="#" data-mailto-retry>Abrir mi correo</a>
      <button class="btn btn--outline" type="button" data-copy>Copiar mensaje</button>
    </div>
    <p class="form-result__copy" aria-live="polite" data-copy-status></p>
  </div>
</form>

<script>
  import { initContactForm } from '../scripts/contact-form.ts';
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(initContactForm);
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-5);
  }

  .contact-form__intro {
    margin: 0;
    color: var(--color-text-muted);
  }

  .contact-form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field label {
    transition: color 0.3s var(--ease);
  }

  .field:focus-within > label {
    color: var(--ink-accent);
  }

  .contact-form__actions {
    display: flex;
  }

  .contact-form__submit {
    gap: var(--space-2);
    min-width: 12rem;
    justify-content: center;
  }

  .contact-form__plane {
    transition: transform 0.45s var(--ease-out);
  }

  .contact-form__submit:hover .contact-form__plane {
    transform: translate(4px, -4px) rotate(8deg);
  }

  .contact-form__spinner {
    display: none;
    width: 1.1rem;
    height: 1.1rem;
    border: 2.5px solid rgb(255 255 255 / 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .contact-form__submit.is-sending {
    cursor: progress;
    opacity: 0.85;
  }

  .contact-form__submit.is-sending .contact-form__spinner {
    display: block;
  }

  .contact-form__submit.is-sending .contact-form__plane {
    display: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Mensaje de envío correcto con una marca que se dibuja. */
  .form-sent {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-success-bg);
  }

  .form-sent[hidden] {
    display: none;
  }

  .form-sent p {
    margin: 0 0 var(--space-2);
  }

  .form-sent__title {
    font-size: var(--fs-md);
    color: var(--ink-accent);
  }

  .form-sent__check {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    fill: none;
    stroke: var(--ink-accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .form-sent:not([hidden]) {
      animation: sent-in 0.6s var(--ease-out);
    }

    .form-sent:not([hidden]) .form-sent__check > * {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: check-draw 0.7s var(--ease-out) forwards;
    }

    .form-sent:not([hidden]) .form-sent__check path {
      animation-delay: 0.45s;
    }
  }

  @keyframes sent-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
  }

  @keyframes check-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .field-row {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-weight: 500;
  }

  .field__optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .field input:not([type='checkbox']),
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid #8aa79a;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease-out);
  }

  .field input:not([type='checkbox']):hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--ink-accent);
  }

  .field input:not([type='checkbox']):focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--ink-accent);
    box-shadow: 0 0 0 4px rgb(94 189 145 / 0.25);
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--color-focus);
    outline-offset: 1px;
  }

  .field [aria-invalid='true'] {
    border-color: var(--color-error) !important;
    background: var(--color-error-bg);
  }

  .field__hint {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .field__error {
    margin: 0;
    color: var(--color-error);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .field__error:empty {
    display: none;
  }

  .field--check {
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: var(--space-3);
  }

  .field--check input {
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.2rem;
    accent-color: var(--verde-700);
  }

  .field--check label {
    font-weight: 400;
  }

  .field--check .field__error {
    grid-column: 2;
  }

  .form-summary {
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-error);
    border-radius: var(--radius-sm);
    background: var(--color-error-bg);
  }

  .form-summary__title {
    font-size: 1.0625rem;
    color: var(--color-error);
    margin-bottom: var(--space-2);
  }

  .form-summary ul {
    margin: 0;
  }

  .form-summary a {
    color: var(--color-error);
  }

  .form-result {
    padding: var(--space-5);
    border-left: 4px solid var(--color-success);
    border-radius: var(--radius-sm);
    background: var(--color-success-bg);
  }

  .form-result__copy {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-sm);
  }

  .form-result__copy:empty {
    display: none;
  }
</style>
