---
/**
 * Botón flotante para volver al inicio de la página, con los colores institucionales del SENA.
 * El anillo exterior muestra cuánto se ha recorrido de la página.
 */
---

<a class="to-top" href="#contenido" data-to-top aria-label="Volver al inicio de la página">
  <svg class="to-top__ring" viewBox="0 0 48 48" aria-hidden="true">
    <rect class="to-top__track" x="2" y="2" width="44" height="44" rx="12" pathLength="100" />
    <rect class="to-top__progress" x="2" y="2" width="44" height="44" rx="12" pathLength="100" />
  </svg>
  <svg class="to-top__arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path d="M6 14.5 12 8.5l6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<script>
  const button = document.querySelector<HTMLAnchorElement>('[data-to-top]');
  if (button) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;

    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      button.style.setProperty('--progress', String(progress * 100));
      button.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();

    button.addEventListener('click', (event) => {
      event.preventDefault();
      button.classList.add('is-launching');
      window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      // El foco vuelve al contenido principal para que el teclado y los lectores de pantalla sigan el salto.
      document.querySelector<HTMLElement>('#contenido')?.focus({ preventScroll: true });
      window.setTimeout(() => button.classList.remove('is-launching'), 700);
    });
  }
</script>

<style>
  .to-top {
    /* Colores institucionales del SENA. */
    --sena-verde: #39a900;
    --sena-azul: #00324d;
    --progress: 0;
    position: fixed;
    right: max(var(--space-4), env(safe-area-inset-right));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: calc(var(--z-header) - 1);
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.85rem;
    background: var(--sena-verde);
    color: #fff;
    box-shadow: 0 10px 24px -10px rgb(0 50 77 / 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(1.5rem) scale(0.7);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease-out),
      visibility 0s linear 0.45s,
      background-color 0.3s var(--ease);
  }

  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .to-top:hover,
  .to-top:focus-visible {
    background: var(--sena-azul);
    color: #fff;
  }

  .to-top:focus-visible {
    outline: 3px solid var(--sena-verde);
    outline-offset: 3px;
  }

  .to-top__ring {
    position: absolute;
    inset: -5px;
    width: calc(100% + 10px);
    height: calc(100% + 10px);
    overflow: visible;
    pointer-events: none;
  }

  .to-top__track,
  .to-top__progress {
    fill: none;
    stroke-width: 2.5;
  }

  .to-top__track {
    stroke: rgb(57 169 0 / 0.22);
  }

  .to-top__progress {
    stroke: var(--sena-azul);
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--progress));
    stroke-linecap: round;
  }

  .to-top:hover .to-top__progress {
    stroke: var(--sena-verde);
  }

  @media (prefers-reduced-motion: no-preference) {
    .to-top:hover {
      transform: translateY(-4px);
    }

    .to-top:hover .to-top__arrow {
      animation: to-top-nudge 0.9s var(--ease-out) infinite;
    }

    .to-top.is-launching .to-top__arrow {
      animation: to-top-launch 0.6s var(--ease-out);
    }
  }

  @keyframes to-top-nudge {
    0%,
    100% {
      transform: none;
    }
    50% {
      transform: translateY(-4px);
    }
  }

  @keyframes to-top-launch {
    40% {
      transform: translateY(-18px);
      opacity: 0;
    }
    41% {
      transform: translateY(14px);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  @media print {
    .to-top {
      display: none;
    }
  }
</style>
