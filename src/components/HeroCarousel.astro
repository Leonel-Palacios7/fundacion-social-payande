---
import { Image } from 'astro:assets';
import HeroPicture from './HeroPicture.astro';
import logo from '../assets/brand/logo-arbol.png';
import { getPhoto } from '../data/photos.ts';
import { renderShape } from '../lib/shapes.ts';
import { site } from '../data/site.ts';

interface Props {
  photoIds: readonly string[];
  eyebrow?: string;
  title?: string;
}

const { photoIds, eyebrow = 'Bienvenidos a', title = site.name } = Astro.props;
const titleWords = title.split(' ');
const slides = await Promise.all(photoIds.map(async (id) => ({ ...getPhoto(id), img: await renderShape(getPhoto(id), 'hero') })));
---

<section class="hero" aria-labelledby="hero-title" data-carousel>
  <div class="hero__slides" role="group" aria-roledescription="carrusel" aria-label="Fotografías de nuestras actividades">
    {
      slides.map((photo, index) => (
        <figure
          class:list={['hero__slide', { 'is-active': index === 0 }]}
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${slides.length}`}
          aria-hidden={index === 0 ? undefined : 'true'}
          data-slide
        >
          {index === 0 ? (
            <HeroPicture photo={photo} class="hero__img" slides={slides.length} />
          ) : (
            // Las demás fotos se insertan después de la carga para no competir con la imagen principal (LCP).
            // HeroPicture las cambia por fotos al azar; estas son las de respaldo.
            <template data-slide-template>
              <picture>
                <source type="image/avif" srcset={photo.img.avif} sizes="100vw" />
                <source type="image/webp" srcset={photo.img.webp} sizes="100vw" />
                <img src={photo.img.src} alt={photo.alt} width={photo.img.width} height={photo.img.height} fetchpriority="low" class="hero__img" />
              </picture>
            </template>
          )}
        </figure>
      ))
    }
  </div>
  <div class="hero__overlay"></div>

  <div class="container hero__content">
    <span class="hero__logo" data-hero-logo aria-hidden="true">
        <span class="hero__halo"></span>
        <span class="hero__ripple"></span>
        <span class="hero__ripple hero__ripple--late"></span>
        <span class="hero__tilt" data-hero-tilt>
          <Image
            src={logo}
            alt=""
            widths={[240, 360, 450]}
            sizes="(min-width: 48rem) 13rem, 8rem"
            class="hero__tree"
            loading="eager"
            fetchpriority="high"
          />
        </span>
    </span>
    <div class="hero__text">
      <p class="hero__eyebrow hero__in" style="--d:0">{eyebrow}</p>
      <h1 id="hero-title" set:html={titleWords.map((word, i) => `<span class="hero__word" style="--i:${i}">${word}</span>`).join(' ')} />
    </div>
  </div>

  <div class="container hero__controls" data-carousel-controls hidden>
    <button class="hero__btn" type="button" data-carousel-prev aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <div class="hero__dots">
      {
        slides.map((_, index) => (
          <button
            class="hero__dot"
            type="button"
            aria-label={`Ver foto ${index + 1}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-carousel-dot={index}
          />
        ))
      }
    </div>
    <button class="hero__btn" type="button" data-carousel-next aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button class="hero__btn hero__btn--pause" type="button" data-carousel-toggle aria-label="Pausar presentación">
      <svg class="icon-pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
      <svg class="icon-play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"></path></svg>
    </button>
  </div>
</section>

<script>
  import { initCarousel } from '../scripts/carousel.ts';
  import { initHeroLogo } from '../scripts/hero-logo.ts';
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    initCarousel(root);
    initHeroLogo(root);
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: min(88svh, 46rem);
    overflow: hidden;
    color: #fff;
    background: var(--verde-900);
  }

  .hero__slides,
  .hero__overlay {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Zoom lento tipo Ken Burns sobre la foto activa */
    .hero__slide.is-active :global(.hero__img) {
      animation: kenburns 9s var(--ease-out) both;
    }

    /* Logo: entra creciendo y desenfocado, luego flota y respira sin parar. */
    .hero__logo {
      animation: logo-in 1.4s var(--ease-out) both;
    }

    .hero__tilt :global(.hero__tree) {
      animation:
        tree-grow 1.6s var(--ease-out) 200ms backwards,
        tree-float 7s ease-in-out 1.8s infinite;
    }

    .hero__halo {
      animation:
        halo-in 1.2s var(--ease-out) both,
        halo-breathe 5s ease-in-out 1.2s infinite;
    }

    .hero__ripple {
      animation: ripple 4.5s var(--ease-out) 1.2s infinite;
    }

    .hero__ripple--late {
      animation-delay: 3.45s;
    }

    /* Al cambiar de foto el logo da un pequeño salto. */
    .hero__logo.is-bumping .hero__tilt {
      animation: logo-bump 900ms var(--ease-out);
    }

    .hero__tilt {
      transition: transform 600ms var(--ease-out);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    #hero-title :global(.hero__word) {
      display: inline-block;
      animation: word-in 1s var(--ease-out) both;
      animation-delay: calc(450ms + var(--i) * 90ms);
    }

    .hero__in {
      animation: fade-up 1s var(--ease-out) both;
      animation-delay: calc(350ms + var(--d) * 90ms);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.55em) rotate(3deg);
      filter: blur(6px);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes logo-in {
    from {
      opacity: 0;
      transform: scale(0.55) rotate(-10deg);
      filter: blur(12px);
    }
  }

  @keyframes tree-grow {
    from {
      clip-path: inset(100% 0 0 0);
      transform: translateY(14%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes tree-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    30% {
      transform: translateY(-4%) rotate(-2deg);
    }
    65% {
      transform: translateY(-1.5%) rotate(1.6deg);
    }
  }

  @keyframes halo-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes halo-breathe {
    50% {
      transform: scale(1.05);
    }
  }

  @keyframes ripple {
    from {
      opacity: 0.7;
      transform: scale(0.85);
    }
    70%,
    to {
      opacity: 0;
      transform: scale(1.45);
    }
  }

  @keyframes logo-bump {
    35% {
      transform: scale(1.08) rotate(-3deg);
    }
    70% {
      transform: scale(0.97) rotate(1.5deg);
    }
  }

  @keyframes kenburns {
    from {
      transform: scale(1.14) translate3d(-1.5%, 1%, 0);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__slide :global(picture),
  .hero__slide :global(.hero__img) {
    width: 100%;
    height: 100%;
  }

  .hero__slide :global(.hero__img) {
    object-fit: cover;
    transform-origin: 60% 40%;
  }

  .hero__overlay {
    background:
      linear-gradient(90deg, rgb(15 59 46 / 0.86) 0%, rgb(15 59 46 / 0.55) 55%, rgb(15 59 46 / 0.15) 100%),
      linear-gradient(0deg, rgb(15 59 46 / 0.6) 0%, transparent 40%);
  }

  /* Logo y texto lado a lado en pantallas anchas; en móvil, el logo arriba. */
  .hero__content {
    position: relative;
    align-self: center;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  .hero__text h1 {
    max-width: 18ch;
    margin-bottom: 0;
    color: #fff;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-2);
    font-size: var(--fs-md);
    letter-spacing: 0.04em;
    color: #d8efe3;
  }

  /* Logo del árbol sobre un halo claro para que se lea encima de cualquier foto. */
  .hero__logo {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(8.5rem, 20vw, 13rem);
    aspect-ratio: 1;
  }

  .hero__halo,
  .hero__ripple {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .hero__halo {
    inset: 6%;
    background: #fff;
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.2),
      0 0 0 14px rgb(255 255 255 / 0.08),
      0 24px 60px rgb(0 0 0 / 0.35);
  }

  .hero__ripple {
    inset: 8%;
    border: 2px solid rgb(201 234 176 / 0.9);
    opacity: 0;
  }

  .hero__tilt {
    position: relative;
    display: block;
    width: 68%;
    transform: perspective(700px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
  }

  .hero__tilt :global(.hero__tree) {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 90%;
  }

  .hero__controls {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
  }

  .hero__controls[hidden] {
    display: none;
  }

  .hero__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    background: rgb(15 59 46 / 0.5);
    color: #fff;
    cursor: pointer;
  }

  .hero__btn:hover {
    background: rgb(15 59 46 / 0.85);
  }

  .hero__btn :focus-visible,
  .hero__btn:focus-visible,
  .hero__dot:focus-visible {
    outline-color: #fff;
  }

  .hero__btn--pause {
    margin-left: auto;
  }

  .hero__btn--pause .icon-play,
  .hero__btn--pause.is-paused .icon-pause {
    display: none;
  }

  .hero__btn--pause.is-paused .icon-play {
    display: block;
  }

  .hero__dots {
    display: flex;
  }

  /* Área táctil de 44px con un indicador visual más pequeño */
  .hero__dot {
    position: relative;
    width: 32px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .hero__dot::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 12px;
    border: 2px solid #fff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .hero__dot[aria-current='true']::after {
    background: #fff;
  }
</style>
