---
import { Picture } from 'astro:assets';
import type { Program } from '../data/programs.ts';
import { getPhoto } from '../data/photos.ts';

interface Props {
  program: Program;
  headingLevel?: 'h2' | 'h3';
}

const { program, headingLevel: Heading = 'h3' } = Astro.props;
const photo = getPhoto(program.photoId);
---

<article class="program-card">
  <Picture
    src={photo.src}
    alt={photo.alt}
    formats={['avif', 'webp']}
    width={640}
    height={440}
    fit="cover"
    sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 92vw"
    class="program-card__img"
  />
  <div class="program-card__body">
    <Heading class="program-card__title">
      <a href={`/programas/#${program.id}`}>{program.title}</a>
    </Heading>
    <p>{program.summary}</p>
  </div>
</article>

<style>
  .program-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .program-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .program-card :global(picture) {
    aspect-ratio: 16 / 11;
  }

  .program-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .program-card__body {
    padding: var(--space-5);
  }

  .program-card__body p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .program-card__title {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .program-card__title a {
    color: var(--color-heading);
    text-decoration: none;
  }

  /* Toda la tarjeta es clicable sin anidar enlaces */
  .program-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .program-card:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .program-card__title a:focus-visible {
    outline: none;
  }
</style>
