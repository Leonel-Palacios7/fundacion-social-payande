---
/**
 * Portada de Inicio sin fotos: auroras con los colores del logo, una luz que sigue al puntero,
 * luciérnagas, hojas que suben y olas en la base; el texto, centrado, entra palabra por palabra.
 */
import { site } from '../data/site.ts';

interface Props {
  eyebrow?: string;
  title?: string;
}

const { eyebrow = 'Bienvenidos a', title = site.name } = Astro.props;
const titleWords = title.split(' ');
// Las palabras clave del lema van resaltadas en verde lima.
const highlight = new Set(['compromiso', 'solidaridad']);
const taglineWords = site.tagline.split(' ');

// [posición %, tamaño px, duración s, retraso s]
const leaves: [number, number, number, number][] = [
  [6, 16, 14, 0],
  [18, 11, 11, 4],
  [31, 20, 16, 7],
  [44, 13, 12, 2],
  [57, 18, 15, 9],
  [66, 12, 10, 5],
  [74, 22, 17, 1],
  [83, 14, 13, 6],
  [91, 17, 15, 3],
  [97, 10, 11, 8],
];

// Luciérnagas repartidas por toda la portada: [x %, y %, tamaño px, duración s, retraso s]
const fireflies: [number, number, number, number, number][] = [
  [8, 22, 6, 9, 0],
  [15, 68, 4, 11, 2],
  [24, 40, 5, 8, 4],
  [33, 82, 7, 12, 1],
  [41, 15, 4, 10, 6],
  [48, 58, 6, 9, 3],
  [56, 30, 5, 13, 5],
  [63, 76, 4, 8, 2],
  [71, 12, 6, 11, 7],
  [78, 50, 5, 10, 1],
  [86, 70, 7, 12, 4],
  [93, 28, 4, 9, 6],
];

---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__blob hero__blob--a"></span>
    <span class="hero__blob hero__blob--b"></span>
    <span class="hero__blob hero__blob--c"></span>

    <span class="hero__aurora hero__aurora--a"></span>
    <span class="hero__aurora hero__aurora--b"></span>
    <span class="hero__spot"></span>
    <span class="hero__grid"></span>

    <div class="hero__flies">
      {fireflies.map(([x, y, size, dur, delay]) => <span class="hero__fly" style={`--x:${x}%;--y:${y}%;--s:${size}px;--dur:${dur}s;--delay:${delay}s`} />)}
    </div>

    <svg class="hero__waves" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path class="hero__wave hero__wave--back" d="M0 60c120 30 240 30 360 0s240-30 360 0 240 30 360 0s240-30 360 0 240 30 360 0s240-30 360 0 240 30 360 0s240-30 360 0v60H0z" />
      <path class="hero__wave hero__wave--front" d="M0 80c120-24 240-24 360 0s240 24 360 0 240-24 360 0s240 24 360 0 240-24 360 0s240 24 360 0 240-24 360 0s240 24 360 0v40H0z" />
    </svg>

    <div class="hero__leaves">
      {
        leaves.map(([x, size, dur, delay], i) => (
          <svg class="hero__leaf" viewBox="0 0 24 24" style={`--x:${x}%;--s:${size}px;--dur:${dur}s;--delay:${delay}s;--turn:${i % 2 ? -1 : 1}`}>
            <path d="M12 2C6 6 4 11 6 17c1 3 3.5 5 6 5s5-2 6-5c2-6 0-11-6-15z" />
            <path d="M12 6v15" />
          </svg>
        ))
      }
    </div>
  </div>

  <div class="container hero__content">
    <div class="hero__text">
      <p class="hero__eyebrow hero__in" style="--d:0">{eyebrow}</p>
      <h1 id="hero-title" set:html={titleWords.map((word, i) => `<span class="hero__word" style="--i:${i}">${word}</span>`).join(' ')} />
    </div>
    <p class="hero__details">
      <svg class="hero__leafmark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2C6 6 4 11 6 17c1 3 3.5 5 6 5s5-2 6-5c2-6 0-11-6-15z" />
        <path d="M12 6v15" />
      </svg>
      <span class="hero__tagline" set:html={taglineWords.map((word, i) => `<span class="hero__tw${highlight.has(word) ? ' hero__tw--hl' : ''}" style="--i:${i}">${word}</span>`).join(' ')} />
    </p>
  </div>

  <a class="hero__scroll" href="#quienes-somos">
    <span class="hero__mouse" aria-hidden="true"><span></span></span>
    <span class="hero__scroll-label">Desliza para conocernos</span>
  </a>

  <button class="hero__pause" type="button" data-hero-pause aria-pressed="false" hidden>
    <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
    <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"></path></svg>
    <span class="visually-hidden">Pausar animación de la portada</span>
  </button>
</section>

<script>
  import { initHero } from '../scripts/hero-logo.ts';
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(90svh, 48rem);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background:
      radial-gradient(120% 90% at 75% 45%, #17553f 0%, transparent 60%),
      linear-gradient(160deg, #0f3b2e 0%, #0b2f25 55%, #0a3a3f 100%);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /*
   * Manchas de color de la marca que se desplazan despacio. El borde suave sale de un
   * degradado radial y no de filter: blur(), que obligaba a repintar capas enormes en cada cuadro.
   */
  .hero__blob {
    position: absolute;
    width: 42vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0.5;
    will-change: transform;
  }

  .hero__blob--a {
    top: -14vmax;
    left: -10vmax;
    background: radial-gradient(closest-side, var(--brand-verde), transparent);
  }

  .hero__blob--b {
    right: -12vmax;
    bottom: -18vmax;
    background: radial-gradient(closest-side, var(--brand-azul), transparent);
    opacity: 0.4;
  }

  .hero__blob--c {
    top: 20%;
    left: 42%;
    width: 26vmax;
    background: radial-gradient(closest-side, var(--brand-lima), transparent);
    opacity: 0.26;
  }

  /* Auroras: franjas de luz con los colores del logo que ondulan despacio. */
  .hero__aurora {
    position: absolute;
    left: -25%;
    width: 150%;
    height: 55%;
    /* Bordes difuminados con una máscara (sin blur ni mezcla de capas, mucho más livianos). */
    mask-image: linear-gradient(180deg, transparent, #000 40%, #000 60%, transparent);
    opacity: 0.55;
    will-change: transform;
    translate: calc(var(--px, 0) * -30px) calc(var(--py, 0) * -20px);
    transition: translate 1.2s var(--ease-out);
  }

  .hero__aurora--a {
    top: -10%;
    background: linear-gradient(100deg, transparent 10%, rgb(142 202 109 / 0.55) 30%, rgb(51 184 184 / 0.5) 50%, transparent 70%);
    transform: rotate(-8deg);
  }

  .hero__aurora--b {
    bottom: -5%;
    background: linear-gradient(80deg, transparent 20%, rgb(31 162 198 / 0.45) 45%, rgb(94 189 145 / 0.45) 65%, transparent 85%);
    transform: rotate(6deg);
  }

  /* Luz que sigue al puntero. */
  .hero__spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(28rem circle at var(--mx, 50%) var(--my, 40%), rgb(201 234 176 / 0.16), transparent 70%);
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .hero.has-pointer .hero__spot {
    opacity: 1;
  }

  /* Trama de puntos muy suave, más visible al centro. */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1.5px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000, transparent 75%);
  }

  /* Luciérnagas que flotan por toda la portada. */
  .hero__flies {
    position: absolute;
    inset: 0;
  }

  .hero__fly {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #e8ffd0;
    box-shadow: 0 0 10px 3px rgb(201 234 176 / 0.8);
    opacity: 0.6;
  }

  /* Olas en la base de la portada. */
  .hero__waves {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 200%;
    max-width: none;
    height: clamp(3rem, 8vw, 6rem);
  }

  .hero__wave--back {
    fill: rgb(51 184 184 / 0.16);
  }

  .hero__wave--front {
    fill: rgb(142 202 109 / 0.14);
  }

  /* Hojas que suben por todo el fondo. */
  .hero__leaves {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__leaf {
    position: absolute;
    bottom: -30px;
    left: var(--x);
    width: var(--s);
    height: var(--s);
    fill: rgb(142 202 109 / 0.55);
    stroke: rgb(15 59 46 / 0.6);
    stroke-width: 1;
    opacity: 0;
  }

  /* Texto centrado; al bajar se aleja y se desvanece (--scroll lo pone hero-logo.ts). */
  .hero__content {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding-block: calc(var(--header-h) + var(--space-8)) 8rem;
    text-align: center;
    translate: 0 calc(var(--scroll, 0) * 80px);
    opacity: calc(1 - var(--scroll, 0) * 1.2);
  }

  .hero__text h1 {
    max-width: 16ch;
    margin: 0 auto;
    color: #fff;
    font-size: clamp(2.6rem, 1.6rem + 4.6vw, 5.5rem);
    filter: drop-shadow(0 4px 24px rgb(0 0 0 / 0.35));
  }

  .hero__eyebrow {
    margin-bottom: var(--space-2);
    font-family: var(--font-script);
    font-size: var(--fs-lg);
    color: #c9eab0;
  }

  /* Lema: frase grande con una hoja y una línea que se dibuja debajo. */
  .hero__details {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    max-width: 36rem;
    margin: 0;
    padding-bottom: var(--space-4);
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    color: #fff;
  }

  .hero__details::after {
    content: '';
    position: absolute;
    left: calc(50% - min(50%, 7rem));
    bottom: 0;
    width: min(100%, 14rem);
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--brand-lima), var(--brand-turquesa), var(--brand-azul));
  }

  .hero__leafmark {
    flex: none;
    width: 1.6em;
    height: 1.6em;
    margin-top: -0.1em;
    fill: var(--brand-lima);
    stroke: var(--verde-900);
    stroke-width: 1;
    transform-origin: 50% 100%;
  }

  .hero__tagline :global(.hero__tw) {
    display: inline-block;
  }

  .hero__tagline :global(.hero__tw--hl) {
    color: #c9eab0;
  }

  /* Indicador para bajar a la siguiente sección. */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    color: #d8efe3;
    font-size: var(--fs-sm);
    text-decoration: none;
    translate: -50% 0;
  }

  .hero__scroll:hover {
    color: #fff;
  }

  .hero__mouse {
    position: relative;
    width: 26px;
    height: 40px;
    border: 2px solid currentColor;
    border-radius: 14px;
  }

  .hero__mouse span {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--brand-lima);
  }

  .hero__scroll:focus-visible,
  .hero__pause:focus-visible {
    outline-color: #fff;
  }

  .hero__pause {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    background: rgb(15 59 46 / 0.6);
    color: #fff;
    cursor: pointer;
  }

  .hero__pause:hover {
    background: rgb(15 59 46 / 0.9);
  }

  .hero__pause[hidden] {
    display: none;
  }

  .hero__pause .icon-play,
  .hero__pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .hero__pause[aria-pressed='true'] .icon-play {
    display: block;
  }

  @media (max-width: 47.99rem) {
    .hero__content {
      padding-top: calc(var(--header-h) + var(--space-7));
    }
  }

  /* ---------- Movimiento ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__blob--a {
      animation: blob-a 18s ease-in-out infinite alternate;
    }

    .hero__blob--b {
      animation: blob-b 22s ease-in-out infinite alternate;
    }

    .hero__blob--c {
      animation: blob-c 16s ease-in-out infinite alternate;
    }

    .hero__fly {
      animation: fly var(--dur) ease-in-out var(--delay) infinite alternate;
    }

    .hero__waves {
      animation: waves 14s linear infinite;
    }

    .hero__wave--back {
      animation: wave-bob 6s ease-in-out infinite alternate;
    }

    .hero__leaf {
      animation: leaf-rise var(--dur) linear var(--delay) infinite;
    }

    .hero__aurora--a {
      animation: aurora-a 16s ease-in-out infinite alternate;
    }

    .hero__aurora--b {
      animation: aurora-b 20s ease-in-out infinite alternate;
    }

    /* Cada palabra del título entra y luego la cruza un destello, una tras otra. */
    #hero-title :global(.hero__word) {
      display: inline-block;
      background: linear-gradient(110deg, #fff 42%, #e3ffc9 50%, #fff 58%) 100% 0 / 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation:
        word-in 1.1s var(--ease-out) both,
        shine 7s ease-in-out 3;
      animation-delay: calc(400ms + var(--i) * 110ms), calc(2.6s + var(--i) * 0.25s);
    }

    .hero__in {
      animation: fade-up 0.9s var(--ease-out) both;
      animation-delay: calc(300ms + var(--d) * 110ms);
    }

    .hero__details::after {
      animation: line-draw 1.2s var(--ease-mask) 1.6s backwards;
    }

    .hero__leafmark {
      animation:
        leaf-pop 1s var(--ease-out) 900ms backwards,
        leaf-sway 4s ease-in-out 2s infinite;
    }

    .hero__tagline :global(.hero__tw) {
      animation: word-in 0.9s var(--ease-out) both;
      animation-delay: calc(1000ms + var(--i) * 90ms);
    }

    .hero__scroll {
      animation: fade-up 1s var(--ease-out) 2s backwards;
    }

    .hero__mouse span {
      animation: wheel 1.8s ease-in-out 2.4s infinite;
    }

    /* Botón de pausa: detiene todo lo que se mueve en la portada. */
    .hero.is-paused *,
    .hero.is-paused :global(*) {
      animation-play-state: paused !important;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fly {
    0% {
      opacity: 0.15;
      transform: translate(0, 0);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0.3;
      transform: translate(60px, -50px);
    }
  }

  @keyframes waves {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes wave-bob {
    to {
      transform: translateY(10px);
    }
  }

  @keyframes aurora-a {
    to {
      transform: rotate(-2deg) translateX(8%) scaleY(1.25);
      opacity: 0.7;
    }
  }

  @keyframes aurora-b {
    to {
      transform: rotate(12deg) translateX(-10%) scaleY(0.8);
      opacity: 0.35;
    }
  }

  @keyframes shine {
    0%,
    70% {
      background-position: 100% 0;
    }
    100% {
      background-position: -50% 0;
    }
  }

  @keyframes leaf-rise {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translate3d(calc(var(--turn) * 70px), -105vh, 0) rotate(calc(var(--turn) * 540deg));
    }
  }

  @keyframes blob-a {
    to {
      transform: translate(18vw, 12vh) scale(1.2);
    }
  }

  @keyframes blob-b {
    to {
      transform: translate(-14vw, -10vh) scale(0.85);
    }
  }

  @keyframes blob-c {
    to {
      transform: translate(-20vw, 14vh) scale(1.3);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.6em) rotate(4deg);
      filter: blur(8px);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes line-draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes leaf-pop {
    from {
      opacity: 0;
      transform: scale(0) rotate(-60deg);
    }
  }

  @keyframes leaf-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-12deg);
    }
  }

  @keyframes wheel {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes panel-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes shimmer {
    0%,
    60% {
      background-position: 100% 0;
    }
    100% {
      background-position: -50% 0;
    }
  }
</style>
