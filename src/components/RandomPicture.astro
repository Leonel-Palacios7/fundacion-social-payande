---
/**
 * Foto que cambia al azar en cada visita.
 * src/scripts/random-photos.ts elige la foto entre las del mismo formato
 * antes de que el navegador descargue ninguna, así no se baja una foto de más.
 */
import type { HTMLAttributes } from 'astro/types';
import type { Photo, PhotoCategory } from '../data/photos.ts';
import { renderShape, type ShapeName } from '../lib/shapes.ts';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'alt' | 'width' | 'height'> {
  photo: Photo;
  shape: Exclude<ShapeName, 'hero'>;
  sizes: string;
  /** Categorías entre las que se elige; vacío = todas. */
  pool?: readonly PhotoCategory[];
  /** Foto decorativa (alt vacío). */
  decorative?: boolean;
  /** false = la foto se queda fija. */
  random?: boolean;
}

const { photo, shape, sizes, pool = [], decorative = false, random = true, ...attrs } = Astro.props;
const img = await renderShape(photo, shape);
const alt = decorative ? '' : photo.alt;
---

{
  random ? (
    // Con JavaScript la foto se elige antes de descargar nada (las rutas van en data-*);
    // sin JavaScript se muestra la foto por defecto dentro de <noscript>.
    <Fragment>
      <picture data-random={shape} data-pool={pool.length ? pool.join(' ') : undefined} data-photo={photo.id}>
        <source type="image/avif" data-srcset={img.avif} sizes={sizes} />
        <source type="image/webp" data-srcset={img.webp} sizes={sizes} />
        <img data-src={img.src} data-alt={alt} alt="" width={img.width} height={img.height} loading="lazy" decoding="async" {...attrs} />
      </picture>
      <noscript>
        <picture>
          <source type="image/avif" srcset={img.avif} sizes={sizes} />
          <source type="image/webp" srcset={img.webp} sizes={sizes} />
          <img src={img.src} alt={alt} width={img.width} height={img.height} loading="lazy" decoding="async" {...attrs} />
        </picture>
      </noscript>
    </Fragment>
  ) : (
    <picture>
      <source type="image/avif" srcset={img.avif} sizes={sizes} />
      <source type="image/webp" srcset={img.webp} sizes={sizes} />
      <img src={img.src} alt={alt} width={img.width} height={img.height} loading="lazy" decoding="async" {...attrs} />
    </picture>
  )
}
