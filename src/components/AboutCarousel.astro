---
/**
 * Carrusel de fotos de «Sobre nosotros»: cada foto entra con un barrido y un leve acercamiento,
 * detrás hay dos marcos de colores que se mueven con cada cambio y la tarjeta se inclina
 * siguiendo al puntero. Tiene botones, puntos, contador, barra de tiempo y pausa;
 * sin JavaScript queda la primera foto.
 */
import RandomPicture from './RandomPicture.astro';
import { getPhoto } from '../data/photos.ts';

interface Props {
  photoIds: readonly string[];
  label: string;
}

const { photoIds, label } = Astro.props;
const photos = photoIds.map(getPhoto);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="about-car" role="region" aria-roledescription="carrusel" aria-label={label} data-about-car>
  <span class="about-car__deck about-car__deck--a" aria-hidden="true"></span>
  <span class="about-car__deck about-car__deck--b" aria-hidden="true"></span>

  <div class="about-car__frame" data-about-frame>
    <div class="about-car__track">
      {
        photos.map((photo, i) => (
          <div
            class:list={['about-car__slide', { 'is-active': i === 0 }]}
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${photos.length}`}
            data-about-slide
          >
            <RandomPicture photo={photo} shape="landscape" sizes="(min-width: 56rem) 34rem, 92vw" random={false} class="about-car__img" />
          </div>
        ))
      }
    </div>

    <span class="about-car__progress" aria-hidden="true"><span></span></span>
    <p class="about-car__count" aria-hidden="true">
      <span data-about-current>01</span><span class="about-car__total"> / {pad(photos.length)}</span>
    </p>

    <div class="about-car__bar" data-about-controls hidden>
      <button class="about-car__btn" type="button" data-about-prev aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <div class="about-car__dots">
        {
          photos.map((_, i) => (
            <button class="about-car__dot" type="button" aria-label={`Ver foto ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} data-about-dot>
              <span></span>
            </button>
          ))
        }
      </div>
      <button class="about-car__btn" type="button" data-about-pause aria-pressed="false" aria-label="Pausar fotos">
        <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
        <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"></path></svg>
      </button>
      <button class="about-car__btn" type="button" data-about-next aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { initAboutCarousel } from '../scripts/about-carousel.ts';
  document.querySelectorAll<HTMLElement>('[data-about-car]').forEach(initAboutCarousel);
</script>

<style>
  .about-car {
    --interval: 5s;
    position: relative;
    padding: 0.9rem 0.9rem 0 0;
  }

  /* Marcos de colores detrás de la foto; se reacomodan en cada cambio. */
  .about-car__deck {
    position: absolute;
    inset: 0.9rem 0 0 0.9rem;
    border-radius: var(--radius-lg);
    transition: transform 0.9s var(--ease-out);
  }

  .about-car__deck--a {
    background: linear-gradient(135deg, var(--brand-lima), var(--brand-verde));
    transform: rotate(3deg);
  }

  .about-car__deck--b {
    background: linear-gradient(135deg, var(--brand-turquesa), var(--brand-azul));
    opacity: 0.85;
    transform: rotate(-2deg) translate(-0.6rem, 0.4rem);
  }

  .about-car.is-shuffled .about-car__deck--a {
    transform: rotate(-3deg) translate(0.4rem, -0.3rem);
  }

  .about-car.is-shuffled .about-car__deck--b {
    transform: rotate(2.5deg) translate(0.5rem, 0.5rem);
  }

  .about-car__frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--verde-900);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
    transform: perspective(1000px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
    transition: transform 0.6s var(--ease-out);
  }

  .about-car__track {
    display: grid;
    aspect-ratio: 4 / 3;
  }

  .about-car__slide {
    grid-area: 1 / 1;
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s 1s;
  }

  .about-car__slide.is-active {
    z-index: 1;
    visibility: visible;
    transition: none;
  }

  .about-car__slide :global(picture),
  .about-car__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about-car__img {
    object-fit: cover;
  }

  /* Barra de tiempo hasta la siguiente foto. */
  .about-car__progress {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: 4px;
    background: rgb(255 255 255 / 0.2);
  }

  .about-car__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--brand-lima), var(--brand-turquesa));
    transform: scaleX(0);
    transform-origin: left;
  }

  .about-car__count {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 2;
    margin: 0;
    padding: 0.2rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgb(8 36 28 / 0.65);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .about-car__count [data-about-current] {
    display: inline-block;
    color: var(--brand-lima);
  }

  .about-car__total {
    opacity: 0.8;
  }

  /* Barra de controles sobre la foto, con un velo para que se lea bien. */
  .about-car__bar {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-7) var(--space-3) var(--space-3);
    background: linear-gradient(transparent, rgb(8 36 28 / 0.8));
  }

  .about-car__bar[hidden] {
    display: none;
  }

  .about-car__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 50%;
    background: rgb(15 59 46 / 0.55);
    color: #fff;
    cursor: pointer;
    transition:
      background-color var(--dur-fast),
      transform 0.3s var(--ease-out);
  }

  .about-car__btn:hover {
    background: rgb(15 59 46 / 0.9);
    transform: scale(1.08);
  }

  .about-car__btn .icon-play,
  .about-car__btn[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .about-car__btn[aria-pressed='true'] .icon-play {
    display: block;
  }

  .about-car__dots {
    display: flex;
    margin-inline: var(--space-2);
  }

  /* Área táctil de 24px con un punto pequeño dentro. */
  .about-car__dot {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .about-car__dot span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.6);
    transition:
      width var(--dur-base) var(--ease),
      background-color var(--dur-base);
  }

  .about-car__dot[aria-current='true'] span {
    width: 22px;
    background: var(--brand-lima);
  }

  .about-car :focus-visible {
    outline-color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* La foto nueva entra con un barrido; data-dir dice de qué lado. */
    .about-car__slide.is-active {
      animation: about-wipe 1s var(--ease-out) both;
    }

    .about-car[data-dir='prev'] .about-car__slide.is-active {
      animation-name: about-wipe-prev;
    }

    .about-car__slide.is-active .about-car__img {
      animation: about-zoom 7s ease-out both;
    }

    .about-car.is-running .about-car__progress span {
      animation: about-progress var(--interval) linear forwards;
    }

    .about-car.is-changed [data-about-current] {
      animation: count-flip 0.6s var(--ease-out);
    }

    .about-car.is-paused .about-car__img {
      animation-play-state: paused;
    }
  }

  @keyframes about-wipe {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes about-wipe-prev {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes about-zoom {
    from {
      transform: scale(1.15);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes about-progress {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes count-flip {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }
</style>
