---
import RandomPicture from './RandomPicture.astro';
import { withBase } from '../lib/paths.ts';
import { getPhoto } from '../data/photos.ts';
import type { FoundationEvent } from '../data/events.ts';

interface Props {
  events: readonly FoundationEvent[];
}

const { events } = Astro.props;
---

<ul class="events" role="list">
  {
    events.map((event, i) => {
      const photo = getPhoto(event.photoId);
      return (
        <li class="event" data-reveal style={`--stagger:${i % 3}`}>
          <article class="event__card" aria-labelledby={`evento-${event.id}`}>
            <div class="event__media">
              <RandomPicture
                photo={photo}
                shape="landscape"
                sizes="(min-width: 64rem) 21rem, (min-width: 40rem) 45vw, 92vw"
                class="event__img"
              />
              {event.date ? (
                <time class="event__badge" datetime={event.date}>{event.badge}</time>
              ) : (
                <span class="event__badge">{event.badge}</span>
              )}
            </div>
            <p class="event__place">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" fill="currentColor" />
              </svg>
              {event.place}
            </p>
            <h3 class="event__title" id={`evento-${event.id}`}>{event.title}</h3>
            <p class="event__text">{event.text}</p>
            <a class="event__btn" href={withBase('/contacto/?motivo=Informaci%C3%B3n%20general')}>
              Más información<span class="visually-hidden"> sobre {event.title}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  .events {
    display: grid;
    gap: clamp(var(--space-4), 2.5vw, var(--space-6));
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
    background: var(--color-card);
    border-radius: 1.5rem;
    box-shadow: 0 1px 0 rgb(15 59 46 / 0.05);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  .event__card:hover,
  .event__card:focus-within {
    transform: translateY(-8px);
    box-shadow: 0 24px 44px -24px rgb(15 59 46 / 0.5);
  }

  .event__media {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    aspect-ratio: 32 / 23;
  }

  .event__media :global(picture) {
    display: block;
    height: 100%;
  }

  .event__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  /* Destello que cruza la foto al pasar el puntero. */
  .event__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  .event__badge {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--color-card);
    border-radius: var(--radius-md);
    color: var(--ink-accent);
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 18px -10px rgb(15 59 46 / 0.6);
  }

  .event__place {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .event__place svg {
    flex: none;
    color: var(--brand-verde);
  }

  .event__title {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
  }

  .event__text {
    margin: 0 0 var(--space-5);
    color: var(--color-text-muted);
  }

  .event__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-top: auto;
    min-height: 48px;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--verde-700);
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease),
      gap var(--dur-base) var(--ease);
  }

  .event__btn:hover {
    background: var(--verde-900);
    color: #fff;
    gap: var(--space-3);
  }

  .event__btn svg {
    transition: transform 0.35s var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .event__card:hover .event__img {
      transform: scale(1.08);
    }

    .event__card:hover .event__media::after {
      transform: translateX(120%);
      transition: transform 0.9s var(--ease-out);
    }

    .event__btn:hover svg {
      transform: rotate(45deg);
    }

    /* El distintivo entra deslizándose cuando la tarjeta aparece. */
    :global(.js) .event .event__badge {
      opacity: 0;
      transform: translateX(24px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.6s var(--ease-out);
    }

    :global(.js) .event.is-visible .event__badge {
      opacity: 1;
      transform: none;
      transition-delay: calc(400ms + var(--stagger, 0) * 120ms);
    }
  }
</style>
