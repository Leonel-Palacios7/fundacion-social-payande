---
import { withBase } from '../lib/paths.ts';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-arbol.png';
import { navItems, isCurrentPath, site } from '../data/site.ts';

const current = Astro.url.pathname;

/** Íconos de la barra (trazos de 24×24). */
const icons: Record<string, string> = {
  '/': '<path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>',
  '/programas/': '<rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><path d="M17 13.5v7M13.5 17h7"/>',
  '/galeria/': '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.8"/><path d="m3.5 18 5.5-5 4 3.5 3-2.5 4.5 4"/>',
  '/contacto/': '<path d="M20.5 12a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1-4.4A8.5 8.5 0 1 1 20.5 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <nav class="tabbar" aria-label="Principal">
      <a class="tabbar__brand" href={withBase('/')} aria-label={`${site.name}, ir al inicio`}>
        <span class="tabbar__ring" aria-hidden="true"></span>
        <Image src={logo} alt="" width={46} height={32} densities={[1, 2, 3]} class="tabbar__logo" loading="eager" />
      </a>
      <ul class="tabbar__list" data-nav-list>
        <li class="tabbar__indicator" aria-hidden="true" data-nav-indicator><span class="tabbar__beam"></span></li>
        {
          navItems.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                class="tabbar__link"
                href={withBase(item.href)}
                aria-current={isCurrentPath(current, withBase(item.href)) ? 'page' : undefined}
              >
                <span class="tabbar__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icons[item.href] ?? ''} />
                  {item.href === '/contacto/' && <span class="tabbar__badge" />}
                </span>
                <span class="tabbar__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <button class="theme-toggle" type="button" aria-label="Modo oscuro" aria-pressed="false" data-theme-toggle hidden>
        <svg class="theme-toggle__svg" viewBox="0 0 24 24" aria-hidden="true">
          <mask id="theme-moon">
            <rect width="24" height="24" fill="#fff"></rect>
            <circle class="theme-toggle__bite" cx="24" cy="4" r="7" fill="#000"></circle>
          </mask>
          <circle class="theme-toggle__core" cx="12" cy="12" r="5" mask="url(#theme-moon)"></circle>
          <g class="theme-toggle__rays">
            <path d="M12 1.5v2.2M12 20.3v2.2M1.5 12h2.2M20.3 12h2.2M4.6 4.6l1.5 1.5M17.9 17.9l1.5 1.5M4.6 19.4l1.5-1.5M17.9 6.1l1.5-1.5"></path>
          </g>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  import { initNavIndicator } from '../scripts/navigation.ts';
  import { initThemeToggle } from '../scripts/theme.ts';
  initNavIndicator();
  initThemeToggle();
</script>

<style>
  /* Cabecera fija; en las páginas con portada oscura flota transparente encima de ella. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-top: env(safe-area-inset-top);
    background: linear-gradient(110deg, #0f3b2e 0%, #134a39 45%, #0b3d42 100%);
    view-transition-name: site-header;
  }

  :global(body:has(main > .hero:first-child, main > .page-hero:first-child, main > .contact-hero:first-child)) .site-header {
    margin-bottom: calc(-1 * var(--header-h) - env(safe-area-inset-top));
    background: transparent;
  }

  /* Al bajar, un velo de vidrio para que la barra se lea sobre cualquier fondo. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 28 22 / 0.6), rgb(6 28 22 / 0.15));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    mask-image: linear-gradient(180deg, #000 60%, transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    pointer-events: none;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--header-h);
  }

  /* ---------- Barra translúcida con indicador tipo lámpara (colores SENA) ---------- */
  .tabbar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: min(100%, 40rem);
    padding: 0.3rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 1.6rem;
    background: rgb(0 50 77 / 0.62);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      0 18px 36px -18px rgb(0 0 0 / 0.7),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
  }

  .tabbar__brand {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 0.5);
    transition: transform 0.4s var(--ease-out);
  }

  .tabbar__brand:hover {
    transform: scale(1.06) rotate(-6deg);
  }

  .tabbar__brand:focus-visible,
  .tabbar__link:focus-visible,
  .theme-toggle:focus-visible {
    outline: 3px solid var(--sena-verde-claro);
    outline-offset: 2px;
  }

  .tabbar__ring {
    position: absolute;
    inset: -3px;
    border: 2px solid var(--sena-verde);
    border-radius: 50%;
    opacity: 0;
  }

  .tabbar__logo {
    display: block;
    width: 2.5rem;
    height: auto;
  }

  .tabbar__list {
    position: relative;
    isolation: isolate;
    flex: 1;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabbar__list > li:not(.tabbar__indicator) {
    flex: 1;
    min-width: 0;
  }

  .tabbar__link {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.2rem;
    min-height: 3.4rem;
    padding: 0.45rem 0.25rem;
    border-radius: 1.2rem;
    color: rgb(255 255 255 / 0.75);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.35s var(--ease);
  }

  .tabbar__link:hover {
    color: #fff;
  }

  .tabbar__link[aria-current='page'] {
    color: var(--sena-verde-claro);
  }

  .tabbar__icon {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    transition:
      transform 0.4s var(--ease-out),
      filter 0.4s var(--ease);
  }

  .tabbar__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* El ícono de la página actual brilla como bajo la luz de la lámpara. */
  .tabbar__link[aria-current='page'] .tabbar__icon {
    filter: drop-shadow(0 0 6px rgb(142 224 90 / 0.85));
  }

  .tabbar__link:hover .tabbar__icon {
    transform: translateY(-2px);
  }

  .tabbar__badge {
    position: absolute;
    top: -2px;
    right: -3px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--sena-azul);
    border-radius: 50%;
    background: var(--sena-verde);
  }

  .tabbar__label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /*
   * Lámpara: una franja verde en el borde superior y un haz de luz que baja hasta el ícono.
   * navigation.ts la mueve al enlace señalado y la devuelve a la página actual.
   */
  .tabbar__indicator {
    position: absolute;
    top: -0.3rem;
    left: 0;
    z-index: -1;
    width: var(--w, 0);
    height: calc(var(--h, 0) + 0.3rem);
    opacity: 0;
    transform: translateX(var(--x, 0));
    transition:
      transform 0.55s var(--ease-out),
      width 0.55s var(--ease-out),
      opacity 0.3s var(--ease);
    pointer-events: none;
  }

  .tabbar__indicator.is-active {
    opacity: 1;
  }

  .tabbar__indicator::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: min(2.6rem, 60%);
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: var(--sena-verde);
    box-shadow:
      0 0 10px 1px rgb(57 169 0 / 0.9),
      0 0 22px 4px rgb(142 224 90 / 0.45);
    translate: -50% 0;
  }

  .tabbar__beam {
    position: absolute;
    top: 4px;
    left: 50%;
    width: min(4.6rem, 100%);
    height: 85%;
    background: linear-gradient(180deg, rgb(57 169 0 / 0.5), rgb(57 169 0 / 0.12) 60%, transparent);
    clip-path: polygon(32% 0, 68% 0, 100% 100%, 0 100%);
    translate: -50% 0;
  }

  /* Sin JavaScript, la página actual se marca con un fondo fijo. */
  :global(html:not(.js)) .tabbar__link[aria-current='page'] {
    background: rgb(57 169 0 / 0.22);
  }

  /* ---------- Botón de modo claro / oscuro ---------- */
  .theme-toggle {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #ffd76a;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      color 0.5s var(--ease),
      transform 0.4s var(--ease-out);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    background: rgb(255 255 255 / 0.16);
    transform: rotate(-12deg) scale(1.05);
  }

  .theme-toggle[aria-pressed='true'] {
    color: #cfe9ff;
  }

  .theme-toggle__svg {
    width: 1.5rem;
    height: 1.5rem;
    overflow: visible;
  }

  .theme-toggle__core {
    fill: currentColor;
    transform-origin: center;
    transition: transform 0.6s var(--ease-out);
  }

  .theme-toggle__bite {
    transition:
      cx 0.6s var(--ease-out),
      cy 0.6s var(--ease-out);
  }

  .theme-toggle__rays {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: center;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.4s var(--ease);
  }

  /* Modo oscuro: el sol se vuelve luna (una mordida tapa el círculo y los rayos se esconden). */
  .theme-toggle[aria-pressed='true'] .theme-toggle__core {
    transform: scale(1.55);
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__bite {
    cx: 16;
    cy: 8;
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__rays {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }

  /* En móvil solo íconos, como la barra de referencia; el nombre sigue disponible para lectores. */
  @media (max-width: 40rem) {
    .tabbar {
      gap: 0.15rem;
    }

    .tabbar__brand {
      width: 2.9rem;
      height: 2.9rem;
    }

    .tabbar__logo {
      width: 2.1rem;
    }

    .tabbar__link {
      min-height: 3rem;
    }

    .tabbar__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tabbar {
      animation: bar-in 0.8s var(--ease-out) backwards;
    }

    .tabbar__list > li:not(.tabbar__indicator) {
      animation: item-in 0.6s var(--ease-out) backwards;
      animation-delay: calc(250ms + var(--i, 0) * 80ms);
    }

    .tabbar__beam {
      animation: beam 3.2s ease-in-out infinite;
    }

    .tabbar__logo {
      animation: logo-sway 6s ease-in-out 1s infinite;
      transform-origin: 50% 90%;
    }

    .tabbar__ring {
      animation: ring 3s var(--ease-out) 1.2s infinite;
    }

    .tabbar__badge {
      animation: badge 2s ease-in-out infinite;
    }

    .tabbar__link:hover .tabbar__icon {
      animation: icon-hop 0.6s var(--ease-out);
    }

    /* Destello en anillo al cambiar de tema. */
    .theme-toggle.is-bursting::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      border: 2px solid currentColor;
      box-shadow: 0 0 18px 4px currentColor;
      animation: burst 0.8s var(--ease-out) forwards;
      pointer-events: none;
    }

    .theme-toggle.is-bursting .theme-toggle__svg {
      animation: toggle-spin 0.8s var(--ease-out);
    }
  }

  @keyframes burst {
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  @keyframes toggle-spin {
    from {
      transform: rotate(-180deg) scale(0.6);
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-16px) scale(0.96);
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes beam {
    50% {
      opacity: 0.65;
    }
  }

  @keyframes logo-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-5deg);
    }
    75% {
      transform: rotate(4deg);
    }
  }

  @keyframes ring {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  @keyframes badge {
    50% {
      transform: scale(1.35);
    }
  }

  @keyframes icon-hop {
    40% {
      transform: translateY(-6px) scale(1.1);
    }
    70% {
      transform: translateY(1px) scale(0.97);
    }
  }
</style>
