---
import { withBase } from '../lib/paths.ts';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-arbol.png';
import { navItems, isCurrentPath, site } from '../data/site.ts';

const current = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={withBase('/')} aria-label={`${site.name}, ir al inicio`}>
      <Image src={logo} alt="" width={64} height={44} densities={[1, 2, 3]} class="brand__logo" loading="eager" />
      <span class="brand__text" aria-hidden="true">
        <span class="brand__small">Fundación Social</span>
        <span class="brand__script">Payandé</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-nav-toggle
    >
      <span class="nav-toggle__icon" aria-hidden="true"><span></span></span>
      <span class="nav-toggle__label">Menú</span>
    </button>

    <nav class="site-nav" id="menu-principal" aria-label="Principal" data-nav>
      <ul class="site-nav__list" data-nav-list>
        <li class="site-nav__indicator" aria-hidden="true" data-nav-indicator></li>
        {
          navItems.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                class:list={['site-nav__link', { 'site-nav__link--cta': item.href === '/contacto/' }]}
                href={withBase(item.href)}
                aria-current={isCurrentPath(current, withBase(item.href)) ? 'page' : undefined}
              >
                <span class="site-nav__label">{item.label}</span>
                {item.href === '/contacto/' && (
                  <svg class="site-nav__arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initNavigation, initNavIndicator, initHeaderAutoHide } from '../scripts/navigation.ts';
  initNavigation();
  initNavIndicator();
  initHeaderAutoHide();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(255 255 255 / 0.97);
    border-bottom: 1px solid var(--color-border);
    padding-top: env(safe-area-inset-top);
    view-transition-name: site-header;
    transition:
      box-shadow var(--dur-base) var(--ease),
      background-color var(--dur-base) var(--ease);
  }

  .site-header.is-scrolled {
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    box-shadow: 0 8px 24px -16px rgb(15 59 46 / 0.45);
  }

  .site-header__inner {
    transition: min-height var(--dur-base) var(--ease);
  }

  .site-header.is-scrolled .site-header__inner {
    min-height: 3.75rem;
  }

  .brand__logo {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .site-header.is-scrolled .brand__logo {
    transform: scale(0.86);
  }

  .brand:hover .brand__logo {
    transform: rotate(-6deg) scale(1.04);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--verde-900);
  }

  .brand__logo {
    width: 64px;
    height: 44px;
    object-fit: contain;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand__small {
    font-size: 0.95rem;
    color: var(--turquesa-700);
    letter-spacing: 0.02em;
  }

  .brand__script {
    font-family: var(--font-script);
    font-size: 1.6rem;
    color: var(--verde-700);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--verde-900);
    font-weight: 500;
    cursor: pointer;
  }

  .nav-toggle__icon,
  .nav-toggle__icon span,
  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease), opacity var(--dur-fast);
  }

  .nav-toggle__icon {
    position: relative;
    background: transparent;
  }

  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle__icon::before {
    top: -6px;
  }
  .nav-toggle__icon::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon span {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::before {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav__link:hover {
    background: var(--verde-50);
    color: var(--verde-900);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--verde-700);
  }

  .site-nav__link--cta {
    background: var(--color-primary);
    color: #fff;
  }

  .site-nav__link--cta:hover,
  .site-nav__link--cta[aria-current='page'] {
    background: var(--color-primary-hover);
    color: #fff;
    border-radius: var(--radius-pill);
  }

  /* Móvil: panel desplegable. Sin JS el menú queda visible (mejora progresiva). */
  @media (max-width: 63.99rem) {
    :global(.js) .site-nav {
      position: absolute;
      inset: 100% 0 auto;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      background: #fff;
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      padding: var(--space-3) var(--gutter) var(--space-5);
    }

    :global(.js) .site-nav:not(.is-open) {
      display: none;
    }

    :global(html:not(.js)) .nav-toggle {
      display: none;
    }

    :global(html:not(.js)) .site-header__inner {
      flex-wrap: wrap;
    }

    .site-nav__link {
      padding: var(--space-3);
      font-size: 1.0625rem;
    }

    .site-nav__link--cta {
      margin-top: var(--space-2);
      text-align: center;
    }
  }

  @media (min-width: 64rem) {
    .nav-toggle {
      display: none;
    }

    .site-nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .site-nav__link {
      padding: var(--space-2) var(--space-3);
    }

    .site-nav__link--cta {
      margin-left: var(--space-2);
      padding-inline: var(--space-4);
    }
  }
  /* ——— Animaciones de la barra de navegación ——— */

  /* Línea con los colores del logo en el borde inferior de la cabecera. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--brand-lima), var(--brand-verde), var(--brand-turquesa), var(--brand-azul), var(--brand-lima));
    background-size: 200% 100%;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
  }

  .site-header.is-scrolled::after {
    opacity: 1;
  }

  .site-header.is-hidden {
    transform: translateY(calc(-100% - 4px));
  }

  .site-nav__label {
    position: relative;
  }

  /* Subrayado que crece desde el centro al pasar el puntero. */
  .site-nav__link:not(.site-nav__link--cta) .site-nav__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-verde), var(--brand-turquesa));
    transform: scaleX(0);
    transition: transform 0.35s var(--ease-out);
  }

  .site-nav__link:hover .site-nav__label::after,
  .site-nav__link:focus-visible .site-nav__label::after,
  .site-nav__link[aria-current='page'] .site-nav__label::after {
    transform: scaleX(1);
  }

  .site-nav__link--cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    overflow: hidden;
    background: linear-gradient(120deg, var(--verde-700), var(--turquesa-700));
    box-shadow: 0 8px 18px -10px rgb(15 59 46 / 0.8);
    transition:
      transform var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease),
      gap var(--dur-base) var(--ease);
  }

  .site-nav__link--cta:hover,
  .site-nav__link--cta[aria-current='page'] {
    background: linear-gradient(120deg, var(--verde-800), var(--azul-700));
    box-shadow: 0 12px 24px -12px rgb(15 59 46 / 0.9);
    gap: var(--space-3);
  }

  /* Destello que cruza el botón de Contacto. */
  .site-nav__link--cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 35%, rgb(255 255 255 / 0.35) 50%, transparent 65%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  .site-nav__arrow {
    transition: transform 0.35s var(--ease-out);
  }

  /* Píldora que se desliza detrás del enlace señalado (solo escritorio, la mueve navigation.ts). */
  .site-nav__indicator {
    display: none;
  }

  @media (min-width: 64rem) {
    .site-nav__list {
      position: relative;
    }

    .site-nav__indicator {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
      width: var(--w, 0);
      height: var(--h, 0);
      border-radius: var(--radius-pill);
      background: var(--verde-50);
      box-shadow: inset 0 0 0 1px var(--verde-100);
      opacity: 0;
      transform: translate(var(--x, 0), var(--y, 0));
      transition:
        transform 0.45s var(--ease-out),
        width 0.45s var(--ease-out),
        opacity 0.25s var(--ease);
      pointer-events: none;
    }

    .site-nav__indicator.is-active {
      opacity: 1;
    }

    .site-nav__list {
      isolation: isolate;
    }

    .site-nav__link:not(.site-nav__link--cta):hover {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      animation: header-in 0.7s var(--ease-out) both;
      transition:
        box-shadow var(--dur-base) var(--ease),
        background-color var(--dur-base) var(--ease),
        transform 0.4s var(--ease-out);
    }

    .site-header.is-scrolled::after {
      animation: header-line 3s linear 1;
    }

    .brand:hover .brand__script {
      animation: brand-wave 0.8s var(--ease-out);
    }

    .site-nav__link--cta:hover::before {
      transform: translateX(120%);
      transition: transform 0.8s var(--ease-out);
    }

    .site-nav__link--cta:hover .site-nav__arrow {
      transform: translateX(3px);
    }

    .site-nav__link--cta:hover {
      transform: translateY(-2px);
    }

    @media (min-width: 64rem) {
      .site-nav__list > li:not(.site-nav__indicator) {
        animation: nav-item-in 0.6s var(--ease-out) both;
        animation-delay: calc(200ms + var(--i, 0) * 70ms);
      }
    }

    /* Panel móvil: cae suavemente y los enlaces entran escalonados. */
    @media (max-width: 63.99rem) {
      :global(.js) .site-nav.is-open {
        animation: menu-in 0.35s var(--ease-out);
      }

      :global(.js) .site-nav.is-open .site-nav__list > li:not(.site-nav__indicator) {
        animation: nav-item-in 0.45s var(--ease-out) both;
        animation-delay: calc(60ms + var(--i, 0) * 50ms);
      }
    }
  }

  @keyframes header-in {
    from {
      transform: translateY(-100%);
    }
  }

  @keyframes header-line {
    to {
      background-position: -200% 0;
    }
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  @keyframes brand-wave {
    30% {
      transform: rotate(-4deg) translateY(-2px);
    }
    60% {
      transform: rotate(3deg);
    }
  }

  .brand__script {
    display: inline-block;
  }
</style>
