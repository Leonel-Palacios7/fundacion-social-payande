---
import { withBase } from '../lib/paths.ts';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-arbol-blanco.png';
import { navItems, isCurrentPath, site } from '../data/site.ts';

const current = Astro.url.pathname;

---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <nav class="tabbar" aria-label="Principal">
      <span class="tabbar__shell" aria-hidden="true"><span class="tabbar__surface"></span></span>
      <a class="tabbar__brand" href={withBase('/')} aria-label={`${site.name}, ir al inicio`}>
        <Image src={logo} alt="" width={46} height={32} densities={[1, 2, 3]} class="tabbar__logo" loading="eager" />
      </a>
      <ul class="tabbar__list" data-nav-list>
        {
          navItems.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                class="tabbar__link"
                href={withBase(item.href)}
                aria-current={isCurrentPath(current, withBase(item.href)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="theme-toggle" type="button" aria-label="Modo oscuro" aria-pressed="false" data-theme-toggle hidden>
        <svg class="theme-toggle__svg" viewBox="0 0 24 24" aria-hidden="true">
          <mask id="theme-moon">
            <rect width="24" height="24" fill="#fff"></rect>
            <circle class="theme-toggle__bite" cx="24" cy="4" r="7" fill="#000"></circle>
          </mask>
          <circle class="theme-toggle__core" cx="12" cy="12" r="5" mask="url(#theme-moon)"></circle>
          <g class="theme-toggle__rays">
            <path d="M12 1.5v2.2M12 20.3v2.2M1.5 12h2.2M20.3 12h2.2M4.6 4.6l1.5 1.5M17.9 17.9l1.5 1.5M4.6 19.4l1.5-1.5M17.9 6.1l1.5-1.5"></path>
          </g>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  import { initThemeToggle } from '../scripts/theme.ts';
  initThemeToggle();
</script>

<style>
  /* Cabecera fija; en las páginas con portada oscura flota transparente encima de ella. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-top: env(safe-area-inset-top);
    background: linear-gradient(110deg, #0f3b2e 0%, #134a39 45%, #0b3d42 100%);
    view-transition-name: site-header;
  }

  :global(body:has(main > .hero:first-child, main > .page-hero:first-child, main > .contact-hero:first-child)) .site-header {
    margin-bottom: calc(-1 * var(--header-h) - env(safe-area-inset-top));
    background: transparent;
  }

  /* Al bajar, un velo de vidrio para que la barra se lea sobre cualquier fondo. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 28 22 / 0.55), rgb(6 28 22 / 0.1));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    mask-image: linear-gradient(180deg, #000 60%, transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    pointer-events: none;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--header-h);
  }

  /*
   * ---------- Barra neomórfica (paleta Payandé) ----------
   * Ocupa todo el ancho del contenedor y va en una sola línea. Es transparente con un
   * velo verde oscuro un poco opaco; la página actual se marca con un relieve hundido.
   */
  .tabbar {
    --bar-bg: rgb(15 59 46 / 0.42);
    --bar-ink: #fff;
    --bar-muted: rgb(255 255 255 / 0.86);
    --neo-dark: rgb(3 20 15 / 0.45);
    --neo-light: rgb(255 255 255 / 0.14);
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 3.6rem;
    padding: 0.35rem 0.5rem;
    color: var(--bar-ink);
    font-family: var(--font-sans);
  }

  :global([data-theme='dark']) .tabbar {
    --bar-bg: rgb(8 30 24 / 0.5);
    --neo-dark: rgb(0 0 0 / 0.55);
    --neo-light: rgb(94 189 145 / 0.14);
  }

  /* Relieve exterior de la barra. */
  .tabbar__shell {
    position: absolute;
    inset: 0;
    z-index: -1;
    filter: drop-shadow(7px 7px 12px var(--neo-dark)) drop-shadow(-5px -5px 10px var(--neo-light));
  }

  .tabbar__surface {
    position: absolute;
    inset: 0;
    border-radius: 1.4rem;
    background: var(--bar-bg);
    backdrop-filter: blur(12px) saturate(1.3);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    box-shadow:
      inset 1px 1px 2px rgb(255 255 255 / 0.22),
      inset -2px -2px 4px rgb(0 0 0 / 0.12);
  }

  .tabbar__brand {
    flex: none;
    display: grid;
    place-items: center;
    padding: 0.25rem;
    border-radius: 50%;
    color: var(--bar-ink);
    text-decoration: none;
    box-shadow:
      4px 4px 8px var(--neo-dark),
      -3px -3px 7px var(--neo-light);
    transition: box-shadow 0.3s var(--ease);
  }

  .tabbar__brand:hover {
    box-shadow:
      inset 3px 3px 6px var(--neo-dark),
      inset -3px -3px 6px var(--neo-light);
  }

  .tabbar__logo {
    display: block;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.35rem 0.2rem;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  .tabbar__list {
    position: relative;
    flex: 1;
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabbar__list > li {
    flex: 0 1 auto;
    min-width: 0;
  }

  /* Cada enlace: solo el nombre, sin relieve; una línea fina marca hover y página actual. */
  .tabbar__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.9rem;
    color: var(--bar-muted);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s var(--ease);
  }

  .tabbar__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.4rem;
    width: calc(100% - 1.8rem);
    height: 2px;
    border-radius: 2px;
    background: var(--sena-verde-claro);
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.35s var(--ease-out);
  }

  .tabbar__link:hover {
    color: var(--bar-ink);
  }

  .tabbar__link:hover::after {
    transform: translateX(-50%) scaleX(0.6);
  }

  .tabbar__link[aria-current='page'] {
    color: var(--bar-ink);
    font-weight: 700;
  }

  .tabbar__link[aria-current='page']::after {
    transform: translateX(-50%) scaleX(1);
  }

  .tabbar__brand:focus-visible,
  .tabbar__link:focus-visible,
  .theme-toggle:focus-visible {
    outline: 3px solid var(--brand-turquesa);
    outline-offset: 2px;
  }

  /* ---------- Botón de modo claro / oscuro (también con relieve) ---------- */
  .theme-toggle {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #ffd76a;
    cursor: pointer;
    box-shadow:
      4px 4px 8px var(--neo-dark),
      -3px -3px 7px var(--neo-light);
    transition:
      color 0.5s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover,
  .theme-toggle:active {
    box-shadow:
      inset 3px 3px 6px var(--neo-dark),
      inset -3px -3px 6px var(--neo-light);
  }

  .theme-toggle[aria-pressed='true'] {
    color: #cfe9ff;
  }

  .theme-toggle__svg {
    width: 1.4rem;
    height: 1.4rem;
    overflow: visible;
  }

  .theme-toggle__core {
    fill: currentColor;
    transform-origin: center;
    transition: transform 0.6s var(--ease-out);
  }

  .theme-toggle__bite {
    transition:
      cx 0.6s var(--ease-out),
      cy 0.6s var(--ease-out);
  }

  .theme-toggle__rays {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: center;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.4s var(--ease);
  }

  /* Modo oscuro: el sol se vuelve luna (una mordida tapa el círculo y los rayos se esconden). */
  .theme-toggle[aria-pressed='true'] .theme-toggle__core {
    transform: scale(1.55);
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__bite {
    cx: 16;
    cy: 8;
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__rays {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }

  /* Pantallas pequeñas: todo en la misma línea, con texto y espacios más compactos. */
  @media (max-width: 44rem) {
    .tabbar {
      gap: var(--space-1);
      padding-inline: 0.35rem;
    }

    .tabbar__list {
      min-width: 0;
      justify-content: space-around;
      gap: 0;
    }

    .tabbar__link {
      padding: 0.35rem clamp(0.3rem, 1.6vw, 0.7rem);
      font-size: clamp(0.78rem, 0.62rem + 0.9vw, 0.95rem);
    }

    .tabbar__link::after {
      width: calc(100% - 2 * clamp(0.3rem, 1.6vw, 0.7rem));
    }

    .tabbar__logo {
      width: 2.4rem;
      height: 2.4rem;
    }
  }

  /*
   * Teléfonos muy angostos: logo y botón de tema más pequeños; si aun así los nombres
   * no caben, la lista se desliza de lado dentro de la barra (sigue en una sola línea).
   */
  @media (max-width: 26.5rem) {
    .tabbar {
      gap: 0.15rem;
      padding-inline: 0.25rem;
    }

    .tabbar__brand {
      padding: 0.1rem;
    }

    .tabbar__logo {
      width: 2.1rem;
      height: 2.1rem;
    }

    .theme-toggle {
      width: 2.4rem;
      height: 2.4rem;
    }

    .tabbar__list {
      min-width: 0;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, transparent, #000 0.5rem, #000 calc(100% - 0.5rem), transparent);
    }

    .tabbar__list::-webkit-scrollbar {
      display: none;
    }

    .tabbar__list > li {
      flex: none;
    }

    .tabbar__link {
      padding-inline: clamp(0.2rem, -0.3rem + 2.5vw, 0.3rem);
      font-size: clamp(0.7rem, 0.38rem + 1.6vw, 0.82rem);
    }

    .tabbar__link:focus-visible {
      outline-offset: -3px;
    }

    .tabbar__link::after {
      width: calc(100% - 0.6rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tabbar {
      animation: bar-in 0.8s var(--ease-out) backwards;
    }

    .tabbar__list > li {
      animation: item-in 0.6s var(--ease-out) backwards;
      animation-delay: calc(250ms + var(--i, 0) * 80ms);
    }

    .tabbar__logo {
      animation: logo-sway 6s ease-in-out 1s infinite;
      transform-origin: 50% 90%;
    }

    /* Destello en anillo al cambiar de tema. */
    .theme-toggle.is-bursting::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      border: 2px solid currentColor;
      box-shadow: 0 0 18px 4px currentColor;
      animation: burst 0.8s var(--ease-out) forwards;
      pointer-events: none;
    }

    .theme-toggle.is-bursting .theme-toggle__svg {
      animation: toggle-spin 0.8s var(--ease-out);
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes logo-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-5deg);
    }
    75% {
      transform: rotate(4deg);
    }
  }

  @keyframes burst {
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  @keyframes toggle-spin {
    from {
      transform: rotate(-180deg) scale(0.6);
    }
  }
</style>
