---
import { withBase } from '../lib/paths.ts';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-arbol.png';
import { navItems, isCurrentPath, site } from '../data/site.ts';

const current = Astro.url.pathname;

/** Íconos de la barra (trazos de 24×24), al estilo de la barra de Pinterest. */
const icons: Record<string, string> = {
  '/': '<path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>',
  '/programas/': '<rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><path d="M17 13.5v7M13.5 17h7"/>',
  '/galeria/': '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.8"/><path d="m3.5 18 5.5-5 4 3.5 3-2.5 4.5 4"/>',
  '/contacto/': '<path d="M20.5 12a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1-4.4A8.5 8.5 0 1 1 20.5 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
};
---

<header class="site-header" data-header>
  <span class="site-header__glow site-header__glow--a" aria-hidden="true"></span>
  <span class="site-header__glow site-header__glow--b" aria-hidden="true"></span>
  <div class="container site-header__inner">
    <nav class="tabbar" aria-label="Principal">
      <a class="tabbar__brand" href={withBase('/')} aria-label={`${site.name}, ir al inicio`}>
        <span class="tabbar__ring" aria-hidden="true"></span>
        <Image src={logo} alt="" width={46} height={32} densities={[1, 2, 3]} class="tabbar__logo" loading="eager" />
      </a>
      <ul class="tabbar__list" data-nav-list>
        <li class="tabbar__indicator" aria-hidden="true" data-nav-indicator></li>
        {
          navItems.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                class="tabbar__link"
                href={withBase(item.href)}
                aria-current={isCurrentPath(current, withBase(item.href)) ? 'page' : undefined}
              >
                <span class="tabbar__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icons[item.href] ?? ''} />
                  {item.href === '/contacto/' && <span class="tabbar__badge" />}
                </span>
                <span class="tabbar__label">{item.label}</span>
                <span class="tabbar__dot" aria-hidden="true"></span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initNavIndicator } from '../scripts/navigation.ts';
  initNavIndicator();
</script>

<style>
  /* Cabecera fija con el mismo fondo verde animado de la portada. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    overflow: hidden;
    padding-top: env(safe-area-inset-top);
    background: linear-gradient(110deg, #0f3b2e 0%, #134a39 45%, #0b3d42 100%);
    view-transition-name: site-header;
    transition: box-shadow var(--dur-base) var(--ease);
  }

  .site-header.is-scrolled {
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.55);
  }

  /* Luces de colores de la marca que se desplazan por el fondo. */
  .site-header__glow {
    position: absolute;
    top: -120%;
    width: 22rem;
    height: 22rem;
    border-radius: 50%;
    filter: blur(50px);
    opacity: 0.4;
    pointer-events: none;
  }

  .site-header__glow--a {
    left: -6rem;
    background: var(--brand-verde);
  }

  .site-header__glow--b {
    right: -4rem;
    background: var(--brand-azul);
    opacity: 0.32;
  }

  /* Línea con los colores del logo en el borde inferior. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-lima), var(--brand-verde), var(--brand-turquesa), var(--brand-azul), var(--brand-lima));
    background-size: 200% 100%;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--header-h);
  }

  /* ---------- Barra tipo píldora (estilo Pinterest, colores SENA) ---------- */
  .tabbar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: min(100%, 38rem);
    padding: 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--sena-azul);
    box-shadow:
      0 14px 30px -14px rgb(0 0 0 / 0.6),
      inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .tabbar__brand {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 0.5);
    transition: transform 0.4s var(--ease-out);
  }

  .tabbar__brand:hover {
    transform: scale(1.06) rotate(-6deg);
  }

  .tabbar__brand:focus-visible,
  .tabbar__link:focus-visible {
    outline: 3px solid var(--sena-verde-claro);
    outline-offset: 2px;
  }

  .tabbar__ring {
    position: absolute;
    inset: -3px;
    border: 2px solid var(--sena-verde);
    border-radius: 50%;
    opacity: 0;
  }

  .tabbar__logo {
    display: block;
    width: 2.6rem;
    height: auto;
  }

  .tabbar__list {
    position: relative;
    isolation: isolate;
    flex: 1;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabbar__list > li:not(.tabbar__indicator) {
    flex: 1;
    min-width: 0;
  }

  .tabbar__link {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    min-height: 3.4rem;
    padding: 0.4rem 0.25rem 0.55rem;
    border-radius: 1.4rem;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .tabbar__link:hover,
  .tabbar__link[aria-current='page'] {
    color: #fff;
  }

  .tabbar__icon {
    position: relative;
    display: block;
    width: 1.45rem;
    height: 1.45rem;
    transition: transform 0.4s var(--ease-out);
  }

  .tabbar__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tabbar__link[aria-current='page'] .tabbar__icon svg {
    fill: rgb(255 255 255 / 0.15);
  }

  .tabbar__link:hover .tabbar__icon {
    transform: translateY(-3px);
  }

  /* Punto verde de aviso en Contacto, como el de la referencia. */
  .tabbar__badge {
    position: absolute;
    top: -2px;
    right: -3px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--sena-azul);
    border-radius: 50%;
    background: var(--sena-verde);
  }

  .tabbar__label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Punto bajo la etiqueta de la página actual. */
  .tabbar__dot {
    position: absolute;
    bottom: 0.2rem;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--sena-verde-claro);
    transform: scale(0);
    transition: transform 0.35s var(--ease-out);
  }

  .tabbar__link[aria-current='page'] .tabbar__dot {
    transform: scale(1);
  }

  /* Pestaña que marca la página actual y sigue al puntero; la mueve navigation.ts. */
  .tabbar__indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: var(--w, 0);
    height: var(--h, 0);
    border-radius: 1.4rem;
    background: linear-gradient(180deg, rgb(57 169 0 / 0.32), rgb(57 169 0 / 0.12));
    box-shadow: inset 0 0 0 2px var(--sena-verde);
    opacity: 0;
    transform: translate(var(--x, 0), var(--y, 0));
    transition:
      transform 0.5s var(--ease-out),
      width 0.5s var(--ease-out),
      opacity 0.25s var(--ease);
    pointer-events: none;
  }

  .tabbar__indicator.is-active {
    opacity: 1;
  }

  /* Sin JavaScript, la página actual se marca con un fondo fijo. */
  :global(html:not(.js)) .tabbar__link[aria-current='page'] {
    background: rgb(57 169 0 / 0.25);
    box-shadow: inset 0 0 0 2px var(--sena-verde);
  }

  @media (max-width: 30rem) {
    .tabbar {
      gap: 0.2rem;
    }

    .tabbar__brand {
      width: 3rem;
      height: 3rem;
    }

    .tabbar__logo {
      width: 2.2rem;
    }

    .tabbar__link {
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__glow--a {
      animation: glow-a 14s ease-in-out infinite alternate;
    }

    .site-header__glow--b {
      animation: glow-b 18s ease-in-out infinite alternate;
    }

    .site-header::after {
      animation: header-line 6s linear infinite;
    }

    .tabbar {
      animation: bar-in 0.8s var(--ease-out) backwards;
    }

    .tabbar__list > li:not(.tabbar__indicator) {
      animation: item-in 0.6s var(--ease-out) backwards;
      animation-delay: calc(250ms + var(--i, 0) * 80ms);
    }

    .tabbar__logo {
      animation: logo-sway 6s ease-in-out 1s infinite;
      transform-origin: 50% 90%;
    }

    .tabbar__ring {
      animation: ring 3s var(--ease-out) 1.2s infinite;
    }

    .tabbar__badge {
      animation: badge 2s ease-in-out infinite;
    }

    .tabbar__link:hover .tabbar__icon {
      animation: icon-hop 0.6s var(--ease-out);
    }
  }

  @keyframes glow-a {
    to {
      transform: translateX(40vw);
    }
  }

  @keyframes glow-b {
    to {
      transform: translateX(-35vw);
    }
  }

  @keyframes header-line {
    to {
      background-position: -200% 0;
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-16px) scale(0.96);
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes logo-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-5deg);
    }
    75% {
      transform: rotate(4deg);
    }
  }

  @keyframes ring {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  @keyframes badge {
    50% {
      transform: scale(1.35);
    }
  }

  @keyframes icon-hop {
    40% {
      transform: translateY(-6px) scale(1.1);
    }
    70% {
      transform: translateY(1px) scale(0.97);
    }
  }
</style>
