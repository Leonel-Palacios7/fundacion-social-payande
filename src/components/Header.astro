---
import { withBase } from '../lib/paths.ts';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-arbol-blanco.png';
import { navItems, isCurrentPath, site } from '../data/site.ts';

const current = Astro.url.pathname;

/** Íconos de la barra (trazos de 24×24). */
const icons: Record<string, string> = {
  '/': '<path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>',
  '/programas/': '<rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><path d="M17 13.5v7M13.5 17h7"/>',
  '/galeria/': '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.8"/><path d="m3.5 18 5.5-5 4 3.5 3-2.5 4.5 4"/>',
  '/contacto/': '<path d="M20.5 12a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1-4.4A8.5 8.5 0 1 1 20.5 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <nav class="tabbar" aria-label="Principal">
      <span class="tabbar__shell" aria-hidden="true"><span class="tabbar__surface"></span></span>
      <a class="tabbar__brand" href={withBase('/')} aria-label={`${site.name}, ir al inicio`}>
        <Image src={logo} alt="" width={46} height={32} densities={[1, 2, 3]} class="tabbar__logo" loading="eager" />
      </a>
      <ul class="tabbar__list" data-nav-list>
        {
          navItems.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                class="tabbar__link"
                href={withBase(item.href)}
                aria-current={isCurrentPath(current, withBase(item.href)) ? 'page' : undefined}
              >
                <span class="tabbar__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icons[item.href] ?? ''} />
                  {item.href === '/contacto/' && <span class="tabbar__badge" />}
                </span>
                <span class="tabbar__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <button class="theme-toggle" type="button" aria-label="Modo oscuro" aria-pressed="false" data-theme-toggle hidden>
        <svg class="theme-toggle__svg" viewBox="0 0 24 24" aria-hidden="true">
          <mask id="theme-moon">
            <rect width="24" height="24" fill="#fff"></rect>
            <circle class="theme-toggle__bite" cx="24" cy="4" r="7" fill="#000"></circle>
          </mask>
          <circle class="theme-toggle__core" cx="12" cy="12" r="5" mask="url(#theme-moon)"></circle>
          <g class="theme-toggle__rays">
            <path d="M12 1.5v2.2M12 20.3v2.2M1.5 12h2.2M20.3 12h2.2M4.6 4.6l1.5 1.5M17.9 17.9l1.5 1.5M4.6 19.4l1.5-1.5M17.9 6.1l1.5-1.5"></path>
          </g>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  import { initThemeToggle } from '../scripts/theme.ts';
  initThemeToggle();
</script>

<style>
  /* Cabecera fija; en las páginas con portada oscura flota transparente encima de ella. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-top: env(safe-area-inset-top);
    background: linear-gradient(110deg, #0f3b2e 0%, #134a39 45%, #0b3d42 100%);
    view-transition-name: site-header;
  }

  :global(body:has(main > .hero:first-child, main > .page-hero:first-child, main > .contact-hero:first-child)) .site-header {
    margin-bottom: calc(-1 * var(--header-h) - env(safe-area-inset-top));
    background: transparent;
  }

  /* Al bajar, un velo de vidrio para que la barra se lea sobre cualquier fondo. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 28 22 / 0.55), rgb(6 28 22 / 0.1));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    mask-image: linear-gradient(180deg, #000 60%, transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    pointer-events: none;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--header-h);
  }

  /*
   * ---------- Barra neomórfica (paleta Payandé) ----------
   * Ocupa todo el ancho del contenedor y va en una sola línea. Es transparente con un
   * velo verde oscuro un poco opaco; la página actual se marca con un relieve hundido.
   */
  .tabbar {
    --bar-bg: rgb(15 59 46 / 0.42);
    --bar-ink: #fff;
    --bar-muted: rgb(255 255 255 / 0.86);
    --neo-dark: rgb(3 20 15 / 0.45);
    --neo-light: rgb(255 255 255 / 0.14);
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 3.6rem;
    padding: 0.35rem 0.5rem;
    color: var(--bar-ink);
    font-family: var(--font-sans);
  }

  :global([data-theme='dark']) .tabbar {
    --bar-bg: rgb(8 30 24 / 0.5);
    --neo-dark: rgb(0 0 0 / 0.55);
    --neo-light: rgb(94 189 145 / 0.14);
  }

  /* Relieve exterior de la barra. */
  .tabbar__shell {
    position: absolute;
    inset: 0;
    z-index: -1;
    filter: drop-shadow(7px 7px 12px var(--neo-dark)) drop-shadow(-5px -5px 10px var(--neo-light));
  }

  .tabbar__surface {
    position: absolute;
    inset: 0;
    border-radius: 1.4rem;
    background: var(--bar-bg);
    backdrop-filter: blur(12px) saturate(1.3);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    box-shadow:
      inset 1px 1px 2px rgb(255 255 255 / 0.22),
      inset -2px -2px 4px rgb(0 0 0 / 0.12);
  }

  .tabbar__brand {
    flex: none;
    display: grid;
    place-items: center;
    padding: 0.25rem;
    border-radius: 50%;
    color: var(--bar-ink);
    text-decoration: none;
    box-shadow:
      4px 4px 8px var(--neo-dark),
      -3px -3px 7px var(--neo-light);
    transition: box-shadow 0.3s var(--ease);
  }

  .tabbar__brand:hover {
    box-shadow:
      inset 3px 3px 6px var(--neo-dark),
      inset -3px -3px 6px var(--neo-light);
  }

  .tabbar__logo {
    display: block;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.35rem 0.2rem;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  .tabbar__list {
    position: relative;
    flex: 1;
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabbar__list > li {
    flex: 0 1 auto;
    min-width: 0;
  }

  /* Cada enlace: ícono y nombre en una misma línea. */
  .tabbar__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-pill);
    color: var(--bar-muted);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .tabbar__link:hover {
    color: var(--bar-ink);
    box-shadow:
      inset 3px 3px 6px var(--neo-dark),
      inset -3px -3px 6px var(--neo-light);
  }

  /* Página actual: relieve hundido y el ícono en verde. */
  .tabbar__link[aria-current='page'] {
    color: var(--bar-ink);
    font-weight: 700;
    box-shadow:
      inset 3px 3px 6px var(--neo-dark),
      inset -3px -3px 6px var(--neo-light);
  }

  .tabbar__link[aria-current='page'] .tabbar__icon {
    color: var(--sena-verde-claro);
  }

  .tabbar__icon {
    position: relative;
    flex: none;
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    transition:
      transform 0.55s var(--ease-out),
      color 0.3s var(--ease);
  }

  .tabbar__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tabbar__badge {
    position: absolute;
    top: -2px;
    right: -3px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--verde-900);
    border-radius: 50%;
    background: var(--sena-verde);
  }

  .tabbar__brand:focus-visible,
  .tabbar__link:focus-visible,
  .theme-toggle:focus-visible {
    outline: 3px solid var(--brand-turquesa);
    outline-offset: 2px;
  }

  /* ---------- Botón de modo claro / oscuro (también con relieve) ---------- */
  .theme-toggle {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #ffd76a;
    cursor: pointer;
    box-shadow:
      4px 4px 8px var(--neo-dark),
      -3px -3px 7px var(--neo-light);
    transition:
      color 0.5s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover,
  .theme-toggle:active {
    box-shadow:
      inset 3px 3px 6px var(--neo-dark),
      inset -3px -3px 6px var(--neo-light);
  }

  .theme-toggle[aria-pressed='true'] {
    color: #cfe9ff;
  }

  .theme-toggle__svg {
    width: 1.4rem;
    height: 1.4rem;
    overflow: visible;
  }

  .theme-toggle__core {
    fill: currentColor;
    transform-origin: center;
    transition: transform 0.6s var(--ease-out);
  }

  .theme-toggle__bite {
    transition:
      cx 0.6s var(--ease-out),
      cy 0.6s var(--ease-out);
  }

  .theme-toggle__rays {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: center;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.4s var(--ease);
  }

  /* Modo oscuro: el sol se vuelve luna (una mordida tapa el círculo y los rayos se esconden). */
  .theme-toggle[aria-pressed='true'] .theme-toggle__core {
    transform: scale(1.55);
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__bite {
    cx: 16;
    cy: 8;
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__rays {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }

  /* Móvil: solo íconos, repartidos en la misma línea; el nombre sigue disponible para lectores. */
  @media (max-width: 44rem) {
    .tabbar {
      gap: var(--space-1);
      padding-inline: 0.35rem;
    }

    .tabbar__list {
      justify-content: space-around;
      gap: 0;
    }

    .tabbar__link {
      padding: 0.35rem 0.7rem;
    }

    .tabbar__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .tabbar__logo {
      width: 2.4rem;
      height: 2.4rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tabbar {
      animation: bar-in 0.8s var(--ease-out) backwards;
    }

    .tabbar__list > li {
      animation: item-in 0.6s var(--ease-out) backwards;
      animation-delay: calc(250ms + var(--i, 0) * 80ms);
    }

    .tabbar__logo {
      animation: logo-sway 6s ease-in-out 1s infinite;
      transform-origin: 50% 90%;
    }

    .tabbar__badge {
      animation: badge 2s ease-in-out infinite;
    }

    /* Destello en anillo al cambiar de tema. */
    .theme-toggle.is-bursting::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      border: 2px solid currentColor;
      box-shadow: 0 0 18px 4px currentColor;
      animation: burst 0.8s var(--ease-out) forwards;
      pointer-events: none;
    }

    .theme-toggle.is-bursting .theme-toggle__svg {
      animation: toggle-spin 0.8s var(--ease-out);
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes logo-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-5deg);
    }
    75% {
      transform: rotate(4deg);
    }
  }

  @keyframes badge {
    50% {
      transform: scale(1.35);
    }
  }

  @keyframes burst {
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  @keyframes toggle-spin {
    from {
      transform: rotate(-180deg) scale(0.6);
    }
  }
</style>
