---
import type { Service } from '../data/services.ts';
import { serviceIcons } from '../lib/service-icons.ts';
import { withBase } from '../lib/paths.ts';
import RandomPicture from './RandomPicture.astro';
import { programs } from '../data/programs.ts';
import { getPhoto } from '../data/photos.ts';

interface Props {
  services: readonly Service[];
}

const { services } = Astro.props;

// Cada tarjeta muestra al pasar el cursor la foto de su programa.
const photoFor = (id: string) => {
  const program = programs.find((p) => p.id === id);
  return program ? getPhoto(program.photoId) : undefined;
};

---

<ul class="services" role="list" data-services>
  {
    services.map((service, i) => (
      <li
        class:list={['service', i % 2 === 0 ? 'service--dark' : 'service--light']}
        data-reveal
        style={`--stagger:${i}`}
      >
        {photoFor(service.id) && (
          <span class="service__photo" aria-hidden="true">
            <RandomPicture photo={photoFor(service.id)!} shape="landscape" sizes="(min-width: 56rem) 24rem, 92vw" random={false} decorative />
          </span>
        )}
        <a class="service__link" href={withBase(`/programas/#${service.id}`)}>
          <svg class="service__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={serviceIcons[service.icon]} />
          <h3 class="service__title">{service.title}</h3>
          <p class="service__text">{service.summary}</p>
          <span class="service__more" aria-hidden="true">Ver programa <span class="service__arrow">→</span></span>
        </a>
      </li>
    ))
  }
</ul>

<script>
  // Luz que sigue al puntero sobre cada tarjeta (solo decorativa).
  document.querySelectorAll<HTMLElement>('[data-services] .service').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      card.style.setProperty('--my', `${event.clientY - rect.top}px`);
    });
  });
</script>

<style>
  .services {
    display: grid;
    gap: clamp(var(--space-4), 2.5vw, var(--space-6));
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .services {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    text-align: center;
    border-radius: 1.5rem;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      color 0.35s var(--ease);
  }

  .service--dark {
    background: var(--verde-900);
    color: #fff;
  }

  .service--light {
    background: #fff;
    color: var(--color-heading);
    box-shadow: 0 1px 0 rgb(15 59 46 / 0.06);
  }

  /* Relleno que sube desde abajo al pasar el puntero. */
  .service::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    transform: translateY(101%);
    border-radius: inherit;
    transition: transform 0.55s var(--ease-out);
  }

  /* Velo sobre la foto para que el texto se lea bien. */
  .service::before {
    background: linear-gradient(160deg, rgb(15 59 46 / 0.86) 0%, rgb(15 59 46 / 0.7) 55%, rgb(11 106 115 / 0.78) 100%);
  }

  /* Foto del programa: aparece con un acercamiento suave al pasar el cursor. */
  .service__photo {
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: 0;
    transform: scale(1.18);
    transition:
      opacity 0.5s var(--ease),
      transform 1.2s var(--ease-out);
  }

  .service__photo :global(picture),
  .service__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service:hover .service__photo,
  .service:focus-within .service__photo {
    opacity: 1;
    transform: scale(1);
  }

  /* Luz que sigue al puntero. */
  .service::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(18rem circle at var(--mx) var(--my), rgb(142 202 109 / 0.28), transparent 60%);
    transition: opacity 0.35s var(--ease);
  }

  /* Toda la tarjeta es un enlace a su programa. */
  .service__link {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-2);
    min-height: 13.5rem;
    padding: var(--space-6) var(--space-5);
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }

  .service__link:focus-visible {
    outline: 3px solid var(--brand-lima);
    outline-offset: -6px;
  }

  .service__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-lima);
    opacity: 0.85;
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease-out);
  }

  .service--light .service__more {
    color: var(--verde-700);
  }

  .service__arrow {
    transition: transform 0.45s var(--ease-out);
  }

  .service:hover .service__more,
  .service:focus-within .service__more {
    opacity: 1;
    color: var(--brand-lima);
  }

  .service:hover .service__arrow,
  .service:focus-within .service__arrow {
    transform: translateX(6px);
  }

  .service__icon {
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: var(--space-2);
    fill: none;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.45s var(--ease-out);
  }

  .service--dark .service__icon {
    stroke: #fff;
  }

  .service--light .service__icon {
    stroke: var(--brand-verde);
  }

  .service__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
    color: inherit;
  }

  .service__text {
    max-width: 22rem;
    margin: 0;
    font-size: var(--fs-base);
    line-height: 1.55;
  }

  .service--dark .service__text {
    color: #d8eee3;
  }

  .service--light .service__text {
    color: var(--color-text-muted);
    transition: color 0.35s var(--ease);
  }

  .service:hover,
  .service:focus-within {
    transform: translateY(-8px);
    box-shadow: 0 22px 40px -22px rgb(15 59 46 / 0.55);
  }

  .service:hover::before,
  .service:focus-within::before {
    transform: translateY(0);
  }

  .service:hover::after {
    opacity: 1;
  }

  .service:hover,
  .service:focus-within,
  .service:hover .service__text,
  .service:focus-within .service__text {
    color: #fff;
  }

  .service:hover .service__icon,
  .service:focus-within .service__icon {
    stroke: var(--brand-lima);
  }

  .service--light:hover .service__icon,
  .service--light:focus-within .service__icon {
    stroke: var(--brand-lima);
  }

  @media (prefers-reduced-motion: no-preference) {
    .service:hover .service__icon {
      animation: service-bounce 0.9s var(--ease-out);
    }

    /* Los íconos se dibujan trazo a trazo cuando la tarjeta entra en pantalla. */
    :global(.js) .service .service__icon > :global(*) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js) .service.is-visible .service__icon > :global(*) {
      animation: service-draw 1.4s var(--ease-out) forwards;
      animation-delay: calc(250ms + var(--stagger, 0) * 120ms);
    }

    :global(.js) .service .service__title,
    :global(.js) .service .service__text {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.6s var(--ease-out),
        color 0.35s var(--ease);
    }

    :global(.js) .service.is-visible .service__title,
    :global(.js) .service.is-visible .service__text {
      opacity: 1;
      transform: none;
      transition-delay: calc(450ms + var(--stagger, 0) * 120ms), calc(450ms + var(--stagger, 0) * 120ms), 0s;
    }

    :global(.js) .service.is-visible .service__text {
      transition-delay: calc(600ms + var(--stagger, 0) * 120ms), calc(600ms + var(--stagger, 0) * 120ms), 0s;
    }
  }

  @keyframes service-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes service-bounce {
    0%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(-8px) scale(1.08) rotate(-4deg);
    }
    60% {
      transform: translateY(2px) scale(0.98);
    }
  }
</style>
