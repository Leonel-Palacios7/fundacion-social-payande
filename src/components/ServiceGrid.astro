---
import type { Service, ServiceIcon } from '../data/services.ts';

interface Props {
  services: readonly Service[];
}

const { services } = Astro.props;

/** Estrella de cinco puntas centrada en (cx, cy), para el ícono de beneficiarios. */
function star(cx: number, cy: number, r: number): string {
  const points = Array.from({ length: 10 }, (_, i) => {
    const angle = (Math.PI / 5) * i - Math.PI / 2;
    const radius = i % 2 === 0 ? r : r * 0.45;
    return `${(cx + radius * Math.cos(angle)).toFixed(2)} ${(cy + radius * Math.sin(angle)).toFixed(2)}`;
  });
  return `M${points.join('L')}Z`;
}

/** Trazos de cada ícono (viewBox 24×24). Se dibujan con stroke para poder animarlos. */
const icons: Record<ServiceIcon, string> = {
  educacion: `
    <ellipse cx="12" cy="12" rx="10" ry="4" pathLength="1" />
    <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)" pathLength="1" />
    <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-60 12 12)" pathLength="1" />
    <circle cx="12" cy="12" r="1.6" pathLength="1" />`,
  padrino: `
    <circle cx="12" cy="6.5" r="3" pathLength="1" />
    <circle cx="5" cy="9" r="2.2" pathLength="1" />
    <circle cx="19" cy="9" r="2.2" pathLength="1" />
    <path d="M7 21v-3a5 5 0 0 1 10 0v3" pathLength="1" />
    <path d="M1.5 21v-2a3.8 3.8 0 0 1 4.6-3.7" pathLength="1" />
    <path d="M22.5 21v-2a3.8 3.8 0 0 0-4.6-3.7" pathLength="1" />`,
  salud: `
    <path d="M12 20.5S3 15 3 8.8a4.8 4.8 0 0 1 9-2.4 4.8 4.8 0 0 1 9 2.4C21 15 12 20.5 12 20.5z" pathLength="1" />
    <path d="M7.5 11h2.2l1.2-2.2 2 4.4 1.3-2.2h2.3" pathLength="1" />`,
  vivienda: `
    <path d="M7 11.8 12 7.5l5 4.3V17H7z" pathLength="1" />
    <path d="M11 17v-3h2v3" pathLength="1" />
    <path d="M12 7.5V5.5h1.5v1.3" pathLength="1" />
    <path d="M2 11v5.4a3 3 0 0 0 .9 2.1L6.5 22" pathLength="1" />
    <path d="M22 11v5.4a3 3 0 0 1-.9 2.1L17.5 22" pathLength="1" />`,
  beneficiarios: `
    <circle cx="12" cy="5" r="2.6" pathLength="1" />
    <path d="M8 14v-2.5a4 4 0 0 1 8 0V14" pathLength="1" />
    <path d="${star(5, 18.5, 3.2)}" pathLength="1" />
    <path d="${star(12, 18.5, 3.2)}" pathLength="1" />
    <path d="${star(19, 18.5, 3.2)}" pathLength="1" />`,
  otros: `
    <path d="M12 4a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.2 1.1 2V17h5v-.2c0-.8.4-1.5 1.1-2A6 6 0 0 0 12 4z" pathLength="1" />
    <path d="M9.5 20h5M10.5 22.5h3" pathLength="1" />
    <path d="M12 .8v1.4M3.2 10H1.8M22.2 10h-1.4M5 3.2l1 1M19 3.2l-1 1" pathLength="1" />`,
};
---

<ul class="services" role="list" data-services>
  {
    services.map((service, i) => (
      <li
        class:list={['service', i % 2 === 0 ? 'service--dark' : 'service--light']}
        data-reveal
        style={`--stagger:${i}`}
      >
        <svg class="service__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[service.icon]} />
        <h3 class="service__title">{service.title}</h3>
        <p class="service__text">{service.summary}</p>
      </li>
    ))
  }
</ul>

<script>
  // Luz que sigue al puntero sobre cada tarjeta (solo decorativa).
  document.querySelectorAll<HTMLElement>('[data-services] .service').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      card.style.setProperty('--my', `${event.clientY - rect.top}px`);
    });
  });
</script>

<style>
  .services {
    display: grid;
    gap: clamp(var(--space-4), 2.5vw, var(--space-6));
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .services {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-2);
    min-height: 13.5rem;
    padding: var(--space-6) var(--space-5);
    overflow: hidden;
    text-align: center;
    border-radius: 1.5rem;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      color 0.35s var(--ease);
  }

  .service--dark {
    background: var(--verde-900);
    color: #fff;
  }

  .service--light {
    background: #fff;
    color: var(--color-heading);
    box-shadow: 0 1px 0 rgb(15 59 46 / 0.06);
  }

  /* Relleno que sube desde abajo al pasar el puntero. */
  .service::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    transform: translateY(101%);
    border-radius: inherit;
    transition: transform 0.55s var(--ease-out);
  }

  .service--dark::before {
    background: linear-gradient(150deg, var(--verde-700), var(--turquesa-700));
  }

  .service--light::before {
    background: linear-gradient(150deg, var(--verde-900), var(--verde-700));
  }

  /* Luz que sigue al puntero. */
  .service::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(18rem circle at var(--mx) var(--my), rgb(142 202 109 / 0.28), transparent 60%);
    transition: opacity 0.35s var(--ease);
  }

  .service__icon {
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: var(--space-2);
    fill: none;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.45s var(--ease-out);
  }

  .service--dark .service__icon {
    stroke: #fff;
  }

  .service--light .service__icon {
    stroke: var(--brand-verde);
  }

  .service__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
    color: inherit;
  }

  .service__text {
    max-width: 22rem;
    margin: 0;
    font-size: var(--fs-base);
    line-height: 1.55;
  }

  .service--dark .service__text {
    color: #d8eee3;
  }

  .service--light .service__text {
    color: var(--color-text-muted);
    transition: color 0.35s var(--ease);
  }

  .service:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 40px -22px rgb(15 59 46 / 0.55);
  }

  .service:hover::before {
    transform: translateY(0);
  }

  .service:hover::after {
    opacity: 1;
  }

  .service--light:hover,
  .service--light:hover .service__text {
    color: #fff;
  }

  .service--light:hover .service__icon {
    stroke: var(--brand-lima);
  }

  @media (prefers-reduced-motion: no-preference) {
    .service:hover .service__icon {
      animation: service-bounce 0.9s var(--ease-out);
    }

    /* Los íconos se dibujan trazo a trazo cuando la tarjeta entra en pantalla. */
    :global(.js) .service .service__icon > :global(*) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js) .service.is-visible .service__icon > :global(*) {
      animation: service-draw 1.4s var(--ease-out) forwards;
      animation-delay: calc(250ms + var(--stagger, 0) * 120ms);
    }

    :global(.js) .service .service__title,
    :global(.js) .service .service__text {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.6s var(--ease-out),
        color 0.35s var(--ease);
    }

    :global(.js) .service.is-visible .service__title,
    :global(.js) .service.is-visible .service__text {
      opacity: 1;
      transform: none;
      transition-delay: calc(450ms + var(--stagger, 0) * 120ms), calc(450ms + var(--stagger, 0) * 120ms), 0s;
    }

    :global(.js) .service.is-visible .service__text {
      transition-delay: calc(600ms + var(--stagger, 0) * 120ms), calc(600ms + var(--stagger, 0) * 120ms), 0s;
    }
  }

  @keyframes service-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes service-bounce {
    0%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(-8px) scale(1.08) rotate(-4deg);
    }
    60% {
      transform: translateY(2px) scale(0.98);
    }
  }
</style>
