---
import { withBase } from '../lib/paths.ts';
import { Image } from 'astro:assets';
import logoBlanco from '../assets/brand/logo-blanco.png';
import { navItems, site, socialLinks, type SocialLink } from '../data/site.ts';
import { services } from '../data/services.ts';
import { serviceIcons } from '../lib/service-icons.ts';

const year = new Date().getFullYear();

/** Hojas que suben por el fondo del pie: posición horizontal, tamaño, duración y retraso. */
const leaves = [
  [6, 18, 11, 0],
  [17, 12, 13, 2.5],
  [29, 22, 12, 5],
  [43, 14, 14, 1.2],
  [58, 20, 11.5, 3.8],
  [71, 12, 13.5, 6],
  [83, 24, 12.5, 0.8],
  [94, 15, 14, 4.4],
] as const;

/** Íconos de redes sociales (trazos propios, viewBox 24×24). */
const socialIcons: Record<SocialLink['id'], string> = {
  facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v7h4v-7h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5z" fill="currentColor"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/>',
  x: '<path d="M4 4h4.6l4 5.6L17.3 4H20l-6.1 7.1L20.5 20h-4.6l-4.3-6-5.1 6H3.8l6.6-7.6z" fill="currentColor"/>',
  youtube:
    '<path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8zM10 15V9l5.2 3z" fill="currentColor"/>',
  whatsapp:
    '<path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.8 7.8c-.3 0-.7.1-.9.5-.3.4-.8 1.2-.3 2.6.6 1.6 2.4 3.6 4.6 4.4 1.3.5 2.1.3 2.6-.1.4-.3.6-.9.6-1.2 0-.2-.1-.3-.3-.4l-1.6-.8c-.2-.1-.4 0-.5.1l-.6.8c-.1.1-.3.2-.5.1a6 6 0 0 1-2.8-2.5c-.1-.2 0-.3.1-.4l.5-.6c.1-.1.1-.3 0-.5l-.7-1.7c-.1-.3-.3-.3-.5-.3z" fill="currentColor"/>',
};

---

<footer class="site-footer" data-footer>
  <svg class="site-footer__wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path class="wave wave--back" d="M0 40c120-26 240-26 360 0s240 26 360 0 240-26 360 0 240 26 360 0v40H0z" />
    <path class="wave wave--front" d="M0 52c120-20 240-20 360 0s240 20 360 0 240-20 360 0 240 20 360 0v28H0z" />
  </svg>

  <div class="site-footer__body">
    <div class="site-footer__leaves" aria-hidden="true">
      {
        leaves.map(([x, size, dur, delay], i) => (
          <svg
            class="leaf"
            viewBox="0 0 24 24"
            style={`--x:${x}%;--s:${size}px;--dur:${dur}s;--delay:${delay}s;--turn:${i % 2 ? -1 : 1}`}
          >
            <path d="M12 2C6 6 4 11 6 17c1 3 3.5 5 6 5s5-2 6-5c2-6 0-11-6-15z" />
            <path d="M12 6v15" />
          </svg>
        ))
      }
    </div>
    <div class="container site-footer__grid">
      <div class="site-footer__brand" data-reveal>
        <a class="site-footer__logo" href={withBase('/')} aria-label={`${site.name}, ir al inicio`}>
          <span class="footer-tree" style={`--logo:url(${logoBlanco.src})`} data-footer-tree>
            <span class="footer-tree__card">
              <span class="footer-tree__halo" aria-hidden="true"></span>
              <span class="footer-tree__shadow" aria-hidden="true"></span>
              <Image src={logoBlanco} alt="" width={140} height={162} densities={[1, 2]} class="footer-tree__full" />
            </span>
          </span>
        </a>
        <p class="site-footer__tagline">{site.tagline}.</p>
        <ul class="social" role="list" aria-label="Redes sociales (próximamente)">
          {
            socialLinks.map((social, i) => (
              <li style={`--i:${i}`}>
                {social.href ? (
                  <a class="social__item" href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons[social.id]} />
                  </a>
                ) : (
                  <span class="social__item" role="img" aria-label={`${social.label} (próximamente)`} title={`${social.label}: próximamente`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons[social.id]} />
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-labelledby="pie-navegacion" data-reveal style="--stagger:1">
        <h2 class="site-footer__title" id="pie-navegacion">Navegación</h2>
        <ul class="site-footer__list" role="list">
          {navItems.map((item) => (
            <li>
              <a class="site-footer__link" href={withBase(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div data-reveal style="--stagger:2">
        <h2 class="site-footer__title">Servicios</h2>
        <ul class="site-footer__list site-footer__services" role="list">
          {
            services.map((service) => (
              <li>
                <a class="site-footer__link site-footer__service" href={withBase(`/programas/#${service.id}`)}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={serviceIcons[service.icon]} />
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--stagger:3">
        <h2 class="site-footer__title">Contacto</h2>
        <ul class="site-footer__list site-footer__contact" role="list">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
            <a class="site-footer__link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
            <a class="site-footer__link" href={`tel:${site.contact.phoneHref}`}>{site.contact.phoneDisplay}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
            <span>{site.contact.address[0]}<br />{site.contact.address[1]}</span>
          </li>
        </ul>
        {site.showProvisionalNotes && site.contact.provisional && (
          <p class="site-footer__note">Correo y teléfono provisionales.</p>
        )}
      </div>
    </div>

    <div class="container site-footer__bottom">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<script>
  // Las animaciones de fondo del pie solo corren mientras está en pantalla.
  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => footer.classList.toggle('is-active', Boolean(entry?.isIntersecting)), {
      threshold: 0.15,
    }).observe(footer);
  }

  // Logo del pie en 3D: se inclina suavemente hacia el puntero y un brillo lo recorre.
  const tree = document.querySelector<HTMLElement>('[data-footer-tree]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tree && fine && !calm) {
    let frame = 0;
    tree.addEventListener('pointermove', (event) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const box = tree.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width - 0.5;
        const y = (event.clientY - box.top) / box.height - 0.5;
        tree.style.setProperty('--ry', `${(x * 22).toFixed(2)}deg`);
        tree.style.setProperty('--rx', `${(y * -18).toFixed(2)}deg`);
        tree.style.setProperty('--gx', `${((x + 0.5) * 100).toFixed(1)}%`);
        tree.classList.add('is-tilting');
      });
    });
    tree.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      frame = 0;
      tree.classList.remove('is-tilting');
      tree.style.removeProperty('--rx');
      tree.style.removeProperty('--ry');
    });
  }
</script>

<style>
  .site-footer {
    position: relative;
    /* La ola se monta sobre el final de la última sección. */
    margin-top: calc(-1 * clamp(40px, 6vw, 80px));
    color: #d9ece2;
  }

  .site-footer__wave {
    display: block;
    width: 100%;
    height: clamp(40px, 6vw, 80px);
    margin-bottom: -1px;
  }

  .wave--back {
    fill: var(--verde-700);
    opacity: 0.55;
  }

  .wave--front {
    fill: var(--verde-900);
  }

  .site-footer__body {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(40rem 22rem at 100% 0%, rgb(51 184 184 / 0.16), transparent 70%),
      radial-gradient(36rem 20rem at 0% 100%, rgb(142 202 109 / 0.12), transparent 70%),
      var(--verde-900);
    padding-top: var(--space-6);
    padding-bottom: max(var(--space-5), env(safe-area-inset-bottom));
  }

  /* Palabra decorativa de fondo. */
  .site-footer__body::before {
    content: 'Payandé';
    position: absolute;
    right: -2rem;
    bottom: -2.5rem;
    font-family: var(--font-script);
    font-size: clamp(6rem, 18vw, 14rem);
    line-height: 1;
    color: rgb(255 255 255 / 0.035);
    pointer-events: none;
  }

  .site-footer a {
    color: #fff;
  }

  .site-footer :focus-visible {
    outline-color: var(--brand-lima);
  }

  .site-footer__grid {
    position: relative;
    display: grid;
    gap: var(--space-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    }
  }

  .site-footer__logo {
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  /*
   * Logo del pie en 3D: una tarjeta con profundidad (halo al fondo, sombra en medio y el logo
   * al frente) que flota despacio y, con el mouse, se inclina hacia el puntero.
   */
  .footer-tree {
    position: relative;
    display: block;
    width: clamp(96px, 70px + 5vw, 140px);
    aspect-ratio: 450 / 522;
    perspective: 700px;
  }

  .footer-tree__card {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-tree.is-tilting .footer-tree__card {
    transition-duration: 0.35s;
  }

  .footer-tree__full {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: translateZ(24px);
  }

  /* Sombra del propio logo, detrás y desplazada: da la sensación de volumen. */
  .footer-tree__shadow {
    position: absolute;
    inset: 0;
    background: rgb(3 20 15 / 0.38);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transform: translate3d(3px, 6px, 0) scale(0.98);
    filter: blur(6px);
  }

  .footer-tree__halo {
    position: absolute;
    inset: -22%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 42%, rgb(142 202 109 / 0.32), transparent 58%),
      radial-gradient(circle at 50% 60%, rgb(51 184 184 / 0.2), transparent 66%);
    transform: translateZ(-30px);
    pointer-events: none;
  }

  /* Brillo suave que recorre la silueta del árbol. */
  .footer-tree__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, rgb(230 255 214 / 0.75) 50%, transparent 62%) var(--gx, 130%) 0 / 260% 100% no-repeat;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transform: translateZ(25px);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .footer-tree.is-tilting .footer-tree__card::after {
    opacity: 0.8;
  }

  .site-footer__tagline {
    margin-bottom: var(--space-2);
    font-family: var(--font-script);
    font-size: var(--fs-md);
    color: #c9eab0;
  }

  .site-footer__brand p:not(.site-footer__tagline) {
    max-width: 24rem;
    font-size: var(--fs-sm);
  }

  .site-footer__title {
    position: relative;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    font-size: 1rem;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2.5rem;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--brand-lima), var(--brand-turquesa));
    transform-origin: left;
    transition: width 0.5s var(--ease-out);
  }

  div:hover > .site-footer__title::after,
  nav:hover > .site-footer__title::after {
    width: 4.5rem;
  }

  .site-footer__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__list li {
    overflow-wrap: anywhere;
  }

  /* Enlaces: una flecha aparece y el texto se desliza. */
  .site-footer__link {
    position: relative;
    display: inline-block;
    text-decoration: none;
    transition:
      color var(--dur-base) var(--ease),
      transform 0.35s var(--ease-out);
  }

  .site-footer__list:not(.site-footer__contact) .site-footer__link::before {
    content: '›';
    position: absolute;
    left: -1rem;
    color: var(--brand-lima);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--dur-base) var(--ease),
      transform 0.35s var(--ease-out);
  }

  .site-footer__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    color: var(--brand-lima);
  }

  .site-footer__link:hover::after,
  .site-footer__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-footer__list:not(.site-footer__contact) .site-footer__link:hover,
  .site-footer__list:not(.site-footer__contact) .site-footer__link:focus-visible {
    transform: translateX(1rem);
  }

  .site-footer__list:not(.site-footer__contact) .site-footer__link:hover::before,
  .site-footer__list:not(.site-footer__contact) .site-footer__link:focus-visible::before {
    opacity: 1;
    transform: none;
  }

  /* Servicios: cada uno lleva a su programa, con su ícono. */
  .site-footer__service {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-footer__service svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--brand-lima);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.45s var(--ease-out);
  }

  .site-footer__service:hover svg,
  .site-footer__service:focus-visible svg {
    transform: scale(1.2) rotate(-8deg);
  }

  /* Hojas decorativas que suben por el fondo. */
  .site-footer__leaves {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .leaf {
    position: absolute;
    left: var(--x);
    bottom: -2rem;
    width: var(--s);
    height: var(--s);
    fill: rgb(142 202 109 / 0.22);
    stroke: rgb(142 202 109 / 0.35);
    stroke-width: 1;
    opacity: 0;
  }

  .site-footer__contact li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* El correo es largo: en pantallas angostas se achica un poco para no partirse. */
  .site-footer__contact a[href^='mailto'] {
    font-size: clamp(0.8rem, 0.6rem + 1.1vw, var(--fs-sm));
    overflow-wrap: anywhere;
  }

  .site-footer__contact svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    fill: none;
    stroke: var(--brand-lima);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .site-footer__note {
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    color: #f6dd8b;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .social__item {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border-radius: 50%;
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.3);
    cursor: default;
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      color 0.3s var(--ease);
  }

  /* Círculo de color que crece desde el centro. */
  .social__item::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--brand-lima), var(--brand-turquesa));
    transform: scale(0);
    transition: transform 0.4s var(--ease-out);
  }

  .social__item svg {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.4s var(--ease-out);
  }

  .social__item:hover {
    color: var(--verde-900);
    box-shadow: inset 0 0 0 1.5px transparent, 0 10px 20px -10px rgb(0 0 0 / 0.6);
  }

  .social__item:hover::before {
    transform: scale(1);
  }

  .site-footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: var(--fs-sm);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wave--back {
      animation: wave-drift 14s ease-in-out 2 alternate;
    }

    .wave--front {
      animation: wave-drift 10s ease-in-out 2 alternate-reverse;
    }

    /* Mientras el pie está en pantalla: las hojas suben y la palabra se desliza.
       Cada animación se repite pocas veces y luego se detiene. */
    .is-active .leaf {
      animation: leaf-rise var(--dur) linear var(--delay) 3;
    }

    .site-footer__body::before {
      transform: translateX(12%);
      opacity: 0;
      transition:
        transform 1.6s var(--ease-out),
        opacity 1.6s var(--ease-out);
    }

    .is-active .site-footer__body::before {
      transform: none;
      opacity: 1;
    }

    .is-active .site-footer__title::after {
      animation: title-line 1.2s var(--ease-out) 300ms both;
    }

    /* Al entrar el pie, el logo flota y gira con calma (3 veces, luego se queda quieto). */
    .is-active .footer-tree:not(.is-tilting) .footer-tree__card {
      animation: tree-float 7s ease-in-out 600ms 3;
    }

    :global(.js) .site-footer__list li {
      opacity: 0;
      transform: translateX(-12px);
      transition:
        opacity 0.5s var(--ease-out),
        transform 0.5s var(--ease-out);
    }

    :global(.js) .is-active .site-footer__list li {
      opacity: 1;
      transform: none;
    }

    :global(.js) .is-active .site-footer__list li:nth-child(2) { transition-delay: 80ms; }
    :global(.js) .is-active .site-footer__list li:nth-child(3) { transition-delay: 160ms; }
    :global(.js) .is-active .site-footer__list li:nth-child(4) { transition-delay: 240ms; }
    :global(.js) .is-active .site-footer__list li:nth-child(5) { transition-delay: 320ms; }
    :global(.js) .is-active .site-footer__list li:nth-child(6) { transition-delay: 400ms; }


    .social__item:hover {
      transform: translateY(-4px);
    }

    .social__item:hover svg {
      transform: scale(1.12) rotate(-8deg);
    }

    :global(.js) .social li {
      opacity: 0;
      transform: translateY(12px) scale(0.8);
      transition:
        opacity 0.5s var(--ease-out),
        transform 0.5s var(--ease-out);
    }

    :global(.js) .is-visible .social li {
      opacity: 1;
      transform: none;
      transition-delay: calc(350ms + var(--i, 0) * 80ms);
    }
  }

  @keyframes leaf-rise {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    15% {
      opacity: 1;
    }
    50% {
