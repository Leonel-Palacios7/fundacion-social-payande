---
interface Props {
  title: string;
  text: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const { title, text, primary, secondary } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn--ghost-light" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(circle at 85% 20%, rgb(142 202 109 / 0.35), transparent 45%),
      linear-gradient(120deg, var(--verde-800) 0%, var(--turquesa-700) 100%);
    color: #fff;
    padding-block: var(--space-8);
  }

  .cta__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .cta__inner {
      grid-template-columns: 1.4fr auto;
    }
  }

  .cta h2 {
    color: #fff;
  }

  .cta p {
    margin: 0;
    font-size: var(--fs-md);
    max-width: 40rem;
  }

  .cta :focus-visible {
    outline-color: #fff;
  }
</style>
