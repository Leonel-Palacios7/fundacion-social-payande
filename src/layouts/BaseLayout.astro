---
import { withBase } from '../lib/paths.ts';
// Solo el subconjunto latino: cubre el español completo (tildes, ñ, ¿, ¡).
import '@fontsource/ubuntu/latin-300.css';
import '@fontsource/ubuntu/latin-400.css';
import '@fontsource/ubuntu/latin-500.css';
import '@fontsource/ubuntu/latin-700.css';
import '@fontsource/kaushan-script/latin-400.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../data/site.ts';
import { getPhoto } from '../data/photos.ts';

interface Props {
  title: string;
  description?: string;
  /** Foto usada en las vistas previas al compartir el enlace. */
  ogPhotoId?: string;
  noindex?: boolean;
}

const { title, description = site.description, ogPhotoId = 'portada-payande-2', noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name} | ${site.tagline}` : `${title} | ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = await getImage({ src: getPhoto(ogPhotoId).src, width: 1200, format: 'jpg', quality: 80 });
const ogImageUrl = Astro.site ? new URL(ogImage.src, Astro.site).href : ogImage.src;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#1e6b4f" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script>
      import { initHeaderOnScroll, initReveal } from '../scripts/reveal.ts';
      initReveal();
      initHeaderOnScroll();
    </script>
  </body>
</html>
