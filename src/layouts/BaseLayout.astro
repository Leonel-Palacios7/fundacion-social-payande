---
import { withBase } from '../lib/paths.ts';
// Solo el subconjunto latino: cubre el español completo (tildes, ñ, ¿, ¡).
import '@fontsource/ubuntu/latin-300.css';
import '@fontsource/ubuntu/latin-400.css';
import '@fontsource/ubuntu/latin-500.css';
import '@fontsource/ubuntu/latin-700.css';
import '@fontsource/kaushan-script/latin-400.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Preloader from '../components/Preloader.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import Cursor from '../components/Cursor.astro';
import { site } from '../data/site.ts';
import { getPhoto } from '../data/photos.ts';

interface Props {
  title: string;
  description?: string;
  /** Foto usada en las vistas previas al compartir el enlace. */
  ogPhotoId?: string;
  noindex?: boolean;
}

const { title, description = site.description, ogPhotoId = 'portada-payande-2', noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name} | ${site.tagline}` : `${title} | ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = await getImage({ src: getPhoto(ogPhotoId).src, width: 1200, format: 'jpg', quality: 80, layout: 'none' });
const ogImageUrl = Astro.site ? new URL(ogImage.src, Astro.site).href : ogImage.src;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Tema guardado o el del sistema, antes de pintar para que no parpadee.
      try {
        var tema = localStorage.getItem('payande-tema');
        if (!tema) tema = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = tema;
      } catch {}
      // Pantalla de carga solo en la primera página de la sesión.
      try {
        if (!sessionStorage.getItem('payande-preload')) {
          sessionStorage.setItem('payande-preload', '1');
          document.documentElement.classList.add('preload');
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#1e6b4f" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Preloader />
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <Cursor />
    <script>
      import { initHeaderOnScroll, initMotionVisibility, initReveal } from '../scripts/reveal.ts';
      import { initRandomPhotos } from '../scripts/random-photos.ts';
      initReveal();
      initHeaderOnScroll();
      initMotionVisibility();
      void initRandomPhotos();
    </script>
  </body>
</html>
