---
import { withBase } from '../lib/paths.ts';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import { programs } from '../data/programs.ts';
import { getPhoto } from '../data/photos.ts';
---

<BaseLayout
  title="Programas"
  description="Educación, niñez, vivienda digna, jóvenes y deporte, y comunidad: conoce los programas de la Fundación Payandé."
  ogPhotoId="slider-10"
>
  <PageHero
    eyebrow="Programas"
    title="Cinco ramas, un mismo propósito"
    lead="Así acompañamos a la comunidad de Payandé en cada etapa de la vida."
    photoId="slider-7"
  />

  <nav class="container program-index" aria-label="Programas en esta página">
    <ProvisionalNote text="Nombres y descripciones deducidos de las fotografías; la Fundación debe confirmarlos." />
    <ul role="list">
      {programs.map((p) => <li><a href={`#${p.id}`}>{p.title}</a></li>)}
    </ul>
  </nav>

  {
    programs.map((program, index) => {
      const photo = getPhoto(program.photoId);
      const number = String(index + 1).padStart(2, '0');
      return (
        <section id={program.id} class="section editorial-wrap" aria-labelledby={`${program.id}-title`}>
          <div class:list={['container', 'editorial', { 'editorial--reverse': index % 2 === 1 }]}>
            <div class="editorial__panel" data-reveal data-number={number}>
              <div class="editorial__head">
                <span class="editorial__arrow" aria-hidden="true">→</span>
                <h2 id={`${program.id}-title`} class="editorial__title">{program.title}</h2>
              </div>
              <hr class="editorial__rule" data-reveal="line" />
              <div class="editorial__meta mono-label">
                <span>programa {number}</span>
                <span>payandé · tolima</span>
              </div>
              <p class="editorial__text">{program.description}</p>
              <ul class="check-list">
                {program.actions.map((action) => <li>{action}</li>)}
              </ul>
              <a class="btn btn--outline btn--arrow" href={withBase(`/galeria/?programa=${program.category}`)}>
                Ver fotos del programa
              </a>
            </div>
            <div class="editorial__photo" data-reveal="mask" data-tone="mono" style="--stagger:2">
              <Picture
                src={photo.src}
                alt={photo.alt}
                formats={['avif', 'webp']}
                width={720}
                height={860}
                fit="cover"
                sizes="(min-width: 56rem) 34rem, 92vw"
                class="editorial__img"
              />
            </div>
          </div>
        </section>
      );
    })
  }

  <CtaBand
    title="¿Quieres apoyar un programa?"
    text="Cuéntanos qué te interesa y te diremos cómo tu ayuda puede llegar a donde más se necesita."
    primary={{ href: '/contacto/', label: 'Escríbenos' }}
    secondary={{ href: '/nosotros/', label: 'Conócenos' }}
  />
</BaseLayout>

<style>
  /* Composición editorial inspirada en la plantilla "Minimal Fashion Promo" */
  .editorial-wrap:nth-of-type(even) {
    background: var(--color-surface-alt);
  }

  .editorial {
    display: grid;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 56rem) {
    .editorial {
      grid-template-columns: 1fr 1fr;
    }

    .editorial--reverse .editorial__panel {
      order: 2;
    }
  }

  .editorial__panel {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    overflow: hidden;
  }

  .editorial__head {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    justify-content: flex-end;
    text-align: right;
  }

  .editorial__arrow {
    font-size: 1.5rem;
    color: var(--turquesa-700);
  }

  .editorial__title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--verde-900);
  }

  .editorial__rule {
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 2px solid var(--verde-900);
  }

  .editorial__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .editorial__text {
    font-size: var(--fs-md);
    color: var(--color-text);
  }

  .editorial__panel .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  /* Número decorativo como pseudo-elemento: no es contenido, no se anuncia */
  .editorial__panel::after {
    content: attr(data-number);
    position: absolute;
    right: -0.05em;
    bottom: -0.25em;
    font-weight: 700;
    font-size: clamp(6rem, 4rem + 10vw, 12rem);
    line-height: 1;
    color: var(--verde-50);
    z-index: -1;
    pointer-events: none;
  }

  .editorial__panel > * {
    position: relative;
  }

  .editorial__photo {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
  }

  .editorial__photo :global(picture),
  .editorial__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .editorial__img {
    object-fit: cover;
  }

  .program-index {
    padding-top: var(--space-6);
  }

  .program-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .program-index a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--verde-800);
    font-weight: 500;
    text-decoration: none;
  }

  .program-index a:hover {
    background: var(--verde-50);
  }
</style>
