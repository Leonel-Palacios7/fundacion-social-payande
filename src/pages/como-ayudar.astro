---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import { getPhoto } from '../data/photos.ts';

const ways = [
  {
    id: 'donaciones',
    title: 'Donaciones en especie',
    text: 'Útiles escolares, zapatos, morrales, juguetes, libros o materiales para mejoramiento de vivienda.',
    photo: getPhoto('slider-18'),
  },
  {
    id: 'voluntariado',
    title: 'Voluntariado',
    text: 'Acompaña jornadas de entrega, actividades recreativas o refuerzo escolar con tu tiempo y talento.',
    photo: getPhoto('slider-17'),
  },
  {
    id: 'alianzas',
    title: 'Alianzas empresariales',
    text: 'Vincula a tu empresa con un programa y construyamos juntos un impacto medible en la comunidad.',
    photo: getPhoto('slider-6'),
  },
];

const faqs = [
  {
    q: '¿Puedo donar dinero en línea?',
    a: 'Por ahora el sitio no recibe pagos en línea. Escríbenos y te enviaremos la información oficial para hacer tu aporte de forma segura.',
  },
  {
    q: '¿Qué tipo de donaciones en especie reciben?',
    a: 'Principalmente útiles escolares, calzado, morrales, juguetes nuevos y materiales de construcción. Antes de entregar, contáctanos para coordinar lo que más se necesita.',
  },
  {
    q: '¿Necesito experiencia para ser voluntario?',
    a: 'No. Solo necesitas disposición y compromiso. Te contaremos las fechas de las próximas jornadas y cómo puedes participar.',
  },
  {
    q: '¿Cómo sé que mi aporte llega a la comunidad?',
    a: 'Compartimos fotografías y reportes de cada jornada. Si tu empresa necesita un informe específico, lo acordamos al crear la alianza.',
  },
];
---

<BaseLayout
  title="Cómo ayudar"
  description="Dona en especie, sé voluntario o crea una alianza con la Fundación Payandé."
  ogPhotoId="slider-18"
>
  <PageHero
    eyebrow="Cómo ayudar"
    title="Cada aporte se convierte en una sonrisa"
    lead="Hay muchas maneras de sumarte. Elige la tuya y escríbenos."
    photoId="portada-sliders"
  />

  <section class="section" aria-labelledby="formas">
    <div class="container">
      <div class="section__header">
        <h2 id="formas">Formas de ayudar</h2>
        <ProvisionalNote text="Formas de apoyo de ejemplo: la Fundación debe confirmar cuáles recibe y cómo." />
      </div>
      <ul class="ways" role="list">
        {
          ways.map((way) => (
            <li class="way" id={way.id}>
              <Picture
                src={way.photo.src}
                alt={way.photo.alt}
                formats={['avif', 'webp']}
                width={600}
                height={450}
                fit="cover"
                sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
                class="way__img"
              />
              <div class="way__body">
                <h3>{way.title}</h3>
                <p>{way.text}</p>
                <a class="btn btn--primary" href={`/contacto/?motivo=${way.id === 'donaciones' ? 'Donaciones' : way.id === 'voluntariado' ? 'Voluntariado' : 'Alianzas'}`}>
                  Quiero {way.id === 'donaciones' ? 'donar' : way.id === 'voluntariado' ? 'ser voluntario' : 'crear una alianza'}
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="pasos">
    <div class="container">
      <div class="section__header">
        <h2 id="pasos">Así de fácil</h2>
      </div>
      <ol class="steps" role="list">
        <li><strong>Escríbenos</strong> con el formulario de contacto y cuéntanos cómo quieres ayudar.</li>
        <li><strong>Coordinamos</strong> contigo qué se necesita, cuándo y dónde.</li>
        <li><strong>Tu aporte llega</strong> a la comunidad y te compartimos el resultado.</li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="preguntas">
    <div class="container--narrow">
      <h2 id="preguntas">Preguntas frecuentes</h2>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ways {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .way {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .way :global(picture) {
    aspect-ratio: 4 / 3;
  }

  .way__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .way__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
  }

  .way__body h3 {
    font-size: 1.3rem;
    margin-bottom: var(--space-2);
  }

  .way__body p {
    flex: 1;
    color: var(--color-text-muted);
  }

  .way__body .btn {
    align-self: flex-start;
  }

  .steps {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: #fff;
    border-radius: var(--radius-md);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--verde-700);
    color: #fff;
    font-weight: 700;
  }

  .steps strong {
    display: block;
    color: var(--color-heading);
    font-size: 1.15rem;
  }

  .faq details {
    border-bottom: 1px solid var(--color-border);
  }

  .faq summary {
    position: relative;
    padding: var(--space-4) var(--space-7) var(--space-4) 0;
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    position: absolute;
    right: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
    color: var(--verde-700);
  }

  .faq details[open] summary::after {
    content: '−';
  }

  .faq details p {
    color: var(--color-text-muted);
  }
</style>
