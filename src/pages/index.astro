---
import { Picture } from 'astro:assets';
import AboutCarousel from '../components/AboutCarousel.astro';
import { withBase } from '../lib/paths.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBrand from '../components/HeroBrand.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import EventCards from '../components/EventCards.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import Gallery from '../components/Gallery.astro';
import PhotoRing from '../components/PhotoRing.astro';
import Marquee from '../components/Marquee.astro';
import { services } from '../data/services.ts';
import { events } from '../data/events.ts';
import { getPhoto } from '../data/photos.ts';
import { site } from '../data/site.ts';

const thanks = getPhoto('slider-9');
const quoteWords =
  '«Muchísimas gracias Fundación Payandé por los útiles escolares y los zapatos, y traer mucha alegría y amor a esta escuela de Payandé».'.split(' ');
// Fondo animado de Testimonios, como el de la portada: [x %, y %, tamaño px, duración s, retraso s]
const quoteFlies: [number, number, number, number, number][] = [
  [6, 20, 5, 9, 0], [18, 70, 4, 11, 2], [30, 35, 6, 8, 4], [44, 85, 4, 12, 1], [57, 15, 5, 10, 6],
  [66, 60, 6, 9, 3], [76, 28, 4, 13, 5], [86, 78, 5, 8, 2], [94, 40, 6, 11, 7],
];
const quoteLeaves: [number, number, number, number][] = [
  [8, 14, 13, 0], [22, 10, 11, 5], [39, 17, 15, 2], [61, 12, 12, 7], [78, 18, 14, 3], [92, 11, 10, 6],
];
const highlights = ['slider-21', 'slider-13', 'slider-3', 'portada-payande-3', 'slider-20', 'slider-5'].map(getPhoto);
---

<BaseLayout title={site.name}>
  <HeroBrand eyebrow="Bienvenidos a" title="Fundación Social Payandé" />

  <Marquee items={services.map((service) => service.title)} />

  <section class="section about" aria-labelledby="quienes-somos">
    <span class="about__word" aria-hidden="true">Payandé</span>
    <svg class="about__leaf about__leaf--a" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6 6 4 11 6 17c1 3 3.5 5 6 5s5-2 6-5c2-6 0-11-6-15z" /><path d="M12 6v15" /></svg>
    <svg class="about__leaf about__leaf--b" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6 6 4 11 6 17c1 3 3.5 5 6 5s5-2 6-5c2-6 0-11-6-15z" /><path d="M12 6v15" /></svg>
    <div class="container split">
      <div class="about__text" data-reveal>
        <h2 class="eyebrow about__eyebrow" id="quienes-somos">Sobre nosotros</h2>
        <p class="lead">
          La Fundación Social Payandé es una organización sin ánimo de lucro que tiene por objeto, desarrollar a su entera
          discreción actividades asistenciales y de beneficencia, tendientes a mejorar <mark class="about__mark">la calidad de vida, la educación, la
          salud, la vivienda y la recreación</mark> a las personas de escasos recursos económicos, localizadas principalmente en los
          municipios de Quebradanegra, Tobia y Villeta.
        </p>
        <ul class="about__places" aria-label="Municipios donde trabajamos">
          {
            ['Quebradanegra', 'Tobia', 'Villeta'].map((place, i) => (
              <li style={`--i:${i}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></svg>
                {place}
              </li>
            ))
          }
        </ul>
        <!-- Leonel pidió dejar el botón sin ninguna acción (2026-10-23). -->
        <span class="btn btn--outline btn--arrow btn--static">Conoce nuestra historia</span>
      </div>
      <div data-reveal="mask" data-tone="mono" style="--stagger:2">
        <AboutCarousel
          label="Fotos de la Fundación"
          photoIds={['portada-payande-1', 'slider-10', 'morrales-pulgar', 'slider-13', 'slider-14', 'slider-3', 'slider-16']}
        />
      </div>
    </div>
  </section>

  <PhotoRing
    word="Payandé"
    photoIds={[
      'slider-13', 'slider-17', 'slider-11', 'slider-14', 'slider-18', 'slider-20', 'slider-9', 'slider-15',
      'slider-16', 'slider-3', 'morrales-pulgar', 'brigada-salud', 'slider-5', 'baloncesto', 'slider-6', 'slider-21',
    ]}
  />

  <section class="section section--alt" aria-labelledby="servicios">
    <div class="container">
      <div class="section__header section__header--center" data-reveal>
        <span class="eyebrow">Servicios</span>
        <h2 id="servicios">Programas Sociales <span class="heading-sub">Quebradanegra, Tobia y Villeta</span></h2>
      </div>
      <ServiceGrid services={services} />
    </div>
  </section>

  <section class="section section--alt events-section" aria-labelledby="eventos">
    <div class="container">
      <div class="section__header section__header--center" data-reveal>
        <h2 class="eyebrow" id="eventos">Eventos</h2>
        <ProvisionalNote text="Salvo la jornada del 31 de octubre en Villeta, las fechas y lugares son de ejemplo." />
      </div>
      <EventCards events={events} />
    </div>
  </section>

  <section class="section testimonials" aria-label="Testimonios" data-testimonials>
    <div class="testimonials__bg" aria-hidden="true">
      <span class="testimonials__blob testimonials__blob--a"></span>
      <span class="testimonials__blob testimonials__blob--b"></span>
      <span class="testimonials__aurora"></span>
      {quoteFlies.map(([x, y, size, dur, delay]) => <span class="testimonials__fly" style={`--x:${x}%;--y:${y}%;--s:${size}px;--dur:${dur}s;--delay:${delay}s`} />)}
      {
        quoteLeaves.map(([x, size, dur, delay], i) => (
          <svg class="testimonials__leaf" viewBox="0 0 24 24" style={`--x:${x}%;--s:${size}px;--dur:${dur}s;--delay:${delay}s;--turn:${i % 2 ? -1 : 1}`}>
            <path d="M12 2C6 6 4 11 6 17c1 3 3.5 5 6 5s5-2 6-5c2-6 0-11-6-15z" />
            <path d="M12 6v15" />
          </svg>
        ))
      }
    </div>
    <div class="container split split--reverse">
      <figure class="quote" data-reveal>
        <svg class="quote__mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6 6 4 11 6 17c1 3 3.5 5 6 5s5-2 6-5c2-6 0-11-6-15z" /><path d="M12 6v15" /></svg>
        <blockquote>
          <p set:html={quoteWords.map((word, i) => `<span class="quote__w" style="--i:${i}">${word}</span>`).join(' ')} />
        </blockquote>
      </figure>
      <div data-reveal style="--stagger:1">
        <span class="eyebrow testimonials__eyebrow">Testimonios</span>
        <Picture
          src={thanks.src}
          alt={thanks.alt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 640, 960, 1200]}
          sizes="(min-width: 56rem) 34rem, 92vw"
          loading="lazy"
          class="rounded-img"
        />
      </div>
    </div>
    <button class="testimonials__pause" type="button" data-testimonials-pause aria-pressed="false" hidden>
      <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
      <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"></path></svg>
      <span class="visually-hidden">Pausar animación de Testimonios</span>
    </button>
  </section>

  <section class="section section--alt" aria-labelledby="historias">
    <div class="container">
      <div class="section__header" data-reveal>
        <h2 class="eyebrow" id="historias">Galería</h2>
      </div>
      <Gallery photos={highlights} id="galeria-inicio" />
      <p class="more-link"><a class="btn btn--outline btn--arrow" href={withBase('/galeria/')}>Ver todas las fotos</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  // Botón para pausar el fondo animado de Testimonios (WCAG 2.2.2).
  document.querySelectorAll<HTMLElement>('[data-testimonials]').forEach((root) => {
    const pause = root.querySelector<HTMLButtonElement>('[data-testimonials-pause]');
    if (!pause || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    pause.hidden = false;
    pause.addEventListener('click', () => {
      const paused = root.classList.toggle('is-paused');
      pause.setAttribute('aria-pressed', String(paused));
    });
  });
</script>

<style>
  /* ---------- Sobre nosotros ---------- */
  .about {
    position: relative;
    overflow: hidden;
  }

  /* Palabra grande de fondo que se desliza despacio. */
  .about__word {
    position: absolute;
    top: 50%;
    left: 0;
    font-family: var(--font-script);
    font-size: clamp(7rem, 22vw, 18rem);
    line-height: 1;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tint-100);
    translate: 0 -50%;
    pointer-events: none;
    user-select: none;
  }

  .about__leaf {
    position: absolute;
    width: 2.2rem;
    height: 2.2rem;
    fill: var(--brand-lima);
    stroke: var(--verde-900);
    stroke-width: 1;
    opacity: 0.7;
    pointer-events: none;
  }

  .about__leaf--a {
    top: 12%;
    left: 46%;
  }

  .about__leaf--b {
    bottom: 10%;
    left: 4%;
    width: 1.6rem;
    fill: var(--brand-turquesa);
  }

  .about .split {
    position: relative;
  }

  /* Línea que crece junto al título pequeño. */
  .about__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .about__eyebrow::after {
    content: '';
    width: 3rem;
    height: 2px;
    background: currentColor;
    transform-origin: left;
  }

  /* Resaltado tipo marcador que se pinta al aparecer. */
  .about__mark {
    padding: 0 0.15em;
    color: inherit;
    background: linear-gradient(transparent 58%, rgb(142 202 109 / 0.5) 58%) no-repeat 0 0 / 100% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .about__places {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .about__places li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--tint-50);
    color: var(--ink-strong);
    font-weight: 500;
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.35s var(--ease);
  }

  .about__places li:hover {
    transform: translateY(-3px);
    background: var(--tint-100);
  }

  .about__places svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: var(--sena-verde);
    stroke-width: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .about__word {
      animation: about-word 40s linear infinite alternate;
    }

    .about__leaf--a {
      animation: about-float 7s ease-in-out infinite;
    }

    .about__leaf--b {
      animation: about-float 9s ease-in-out 1s infinite reverse;
    }

    :global(.js) .about__text .about__mark {
      background-size: 0% 100%;
      transition: background-size 1.4s var(--ease-out) 0.6s;
    }

    :global(.js) .about__text.is-visible .about__mark {
      background-size: 100% 100%;
    }

    :global(.js) .about__text .about__eyebrow::after {
      transform: scaleX(0);
      transition: transform 1s var(--ease-out) 0.3s;
    }

    :global(.js) .about__text.is-visible .about__eyebrow::after {
      transform: scaleX(1);
    }

    :global(.js) .about__text .about__places li {
      opacity: 0;
      transform: translateY(14px) scale(0.9);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.6s var(--ease-out);
      transition-delay: calc(0.9s + var(--i) * 0.15s);
    }

    :global(.js) .about__text.is-visible .about__places li {
      opacity: 1;
      transform: none;
    }

    :global(.js) .about__text.is-visible .about__places li:hover {
      transform: translateY(-3px);
      transition-delay: 0s;
    }

    .about__places li:hover svg {
      animation: pin-bounce 0.6s var(--ease-out);
    }
  }

  @keyframes about-word {
    to {
      transform: translateX(-30%);
    }
  }

  @keyframes about-float {
    50% {
      transform: translateY(-14px) rotate(18deg);
    }
  }

  @keyframes pin-bounce {
    40% {
      transform: translateY(-5px);
    }
  }

  /* Dos secciones seguidas con el mismo fondo: se juntan sin doble espacio. */
  .btn--static {
    pointer-events: none;
  }

  .heading-sub {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--ink-accent);
  }

  .events-section {
    padding-top: 0;
  }

  /* ---------- Testimonios: mismo fondo animado que la portada ---------- */
  .testimonials {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background:
      radial-gradient(120% 90% at 25% 50%, #17553f 0%, transparent 60%),
      linear-gradient(160deg, #0f3b2e 0%, #0b2f25 55%, #0a3a3f 100%);
  }

  .testimonials__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .testimonials__blob {
    position: absolute;
    width: 36vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.4;
  }

  .testimonials__blob--a {
    top: -12vmax;
    right: -8vmax;
    background: var(--brand-verde);
  }

  .testimonials__blob--b {
    bottom: -16vmax;
    left: -10vmax;
    background: var(--brand-azul);
    opacity: 0.32;
  }

  .testimonials__aurora {
    position: absolute;
    top: 10%;
    left: -25%;
    width: 150%;
    height: 50%;
    background: linear-gradient(100deg, transparent 10%, rgb(142 202 109 / 0.5) 30%, rgb(51 184 184 / 0.45) 50%, transparent 70%);
    filter: blur(60px);
    opacity: 0.45;
    mix-blend-mode: screen;
    transform: rotate(-6deg);
  }

  .testimonials__fly {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #e8ffd0;
    box-shadow: 0 0 10px 3px rgb(201 234 176 / 0.8);
    opacity: 0.6;
  }

  .testimonials__leaf {
    position: absolute;
    bottom: -30px;
    left: var(--x);
    width: var(--s);
    height: var(--s);
    fill: rgb(142 202 109 / 0.55);
    stroke: rgb(15 59 46 / 0.6);
    stroke-width: 1;
    opacity: 0;
  }

  .testimonials__eyebrow {
    color: #c9eab0;
  }

  .testimonials .split {
    position: relative;
  }

  .quote {
    position: relative;
    margin: 0;
    padding: var(--space-6);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-left: 6px solid var(--brand-lima);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.07);
    backdrop-filter: blur(6px);
  }

  .quote__mark {
    position: absolute;
    top: -1.2rem;
    right: var(--space-5);
    width: 2.6rem;
    height: 2.6rem;
    fill: var(--brand-lima);
    stroke: var(--verde-900);
    stroke-width: 1;
    transform-origin: 50% 100%;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote p {
    margin: 0;
    font-family: var(--font-script);
    font-size: var(--fs-lg);
    line-height: 1.45;
    color: #fff;
  }

  .quote :global(.quote__w) {
    display: inline-block;
  }

  .testimonials__pause {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    background: rgb(15 59 46 / 0.6);
    color: #fff;
    cursor: pointer;
  }

  .testimonials__pause:hover {
    background: rgb(15 59 46 / 0.9);
  }

  .testimonials__pause:focus-visible {
    outline-color: #fff;
  }

  .testimonials__pause[hidden] {
    display: none;
  }

  .testimonials__pause .icon-play,
  .testimonials__pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .testimonials__pause[aria-pressed='true'] .icon-play {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .testimonials__blob--a {
      animation: t-blob-a 18s ease-in-out infinite alternate;
    }

    .testimonials__blob--b {
      animation: t-blob-b 22s ease-in-out infinite alternate;
    }

    .testimonials__aurora {
      animation: t-aurora 16s ease-in-out infinite alternate;
    }

    .testimonials__fly {
      animation: t-fly var(--dur) ease-in-out var(--delay) infinite alternate;
    }

    .testimonials__leaf {
      animation: t-leaf-rise var(--dur) linear var(--delay) infinite;
    }

    /* Las palabras de la cita entran una a una cuando la tarjeta aparece, como el título de la portada. */
    :global(.js) .quote :global(.quote__w) {
      opacity: 0;
    }

    :global(.js) .quote.is-visible :global(.quote__w) {
      animation: t-word-in 0.9s var(--ease-out) both;
      animation-delay: calc(300ms + var(--i) * 70ms);
    }

    :global(.js) .quote.is-visible .quote__mark {
      animation:
        t-leaf-pop 1s var(--ease-out) 200ms backwards,
        t-leaf-sway 4s ease-in-out 1.4s infinite;
    }

    .testimonials.is-paused *,
    .testimonials.is-paused :global(*) {
      animation-play-state: paused !important;
    }
  }

  @keyframes t-blob-a {
    to {
      transform: translate(-16vw, 10vh) scale(1.2);
    }
  }

  @keyframes t-blob-b {
    to {
      transform: translate(14vw, -8vh) scale(0.85);
    }
  }

  @keyframes t-aurora {
    to {
      transform: rotate(2deg) translateX(8%) scaleY(1.25);
      opacity: 0.65;
    }
  }

  @keyframes t-fly {
    0% {
      opacity: 0.15;
      transform: translate(0, 0);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0.3;
      transform: translate(60px, -50px);
    }
  }

  @keyframes t-leaf-rise {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translate3d(calc(var(--turn) * 70px), -110vh, 0) rotate(calc(var(--turn) * 540deg));
    }
  }

  @keyframes t-word-in {
    from {
      opacity: 0;
      transform: translateY(0.6em) rotate(4deg);
      filter: blur(8px);
    }
    to {
      opacity: 1;
    }
  }

  @keyframes t-leaf-pop {
    from {
      opacity: 0;
      transform: scale(0) rotate(-60deg);
    }
  }

  @keyframes t-leaf-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-12deg);
    }
  }

  .more-link {
    margin: var(--space-6) 0 0;
    text-align: center;
  }
</style>
