---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import HeroPicture from '../components/HeroPicture.astro';
import { getPhoto } from '../data/photos.ts';
import { site } from '../data/site.ts';

const heroPhoto = getPhoto('slider-19');
---

<BaseLayout
  title="Contacto"
  description="Escríbele a la Fundación Social Payandé para pedir información sobre sus servicios."
  ogPhotoId="slider-17"
>
  <section class="contact-hero" aria-labelledby="page-title">
    <HeroPicture photo={heroPhoto} class="contact-hero__img" decorative />
    <div class="contact-hero__overlay"></div>
    <div class="container contact-hero__content">
      <h1 id="page-title" class="contact-hero__title" aria-label="Contacto">
        {'Contacto'.split('').map((letter, i) => <span aria-hidden="true" style={`--i:${i}`}>{letter}</span>)}
      </h1>
    </div>
    <div class="contact-hero__badges" aria-hidden="true">
      <span class="badge badge--phone"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg></span>
      <span class="badge badge--mail"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span>
      <span class="badge badge--pin"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg></span>
    </div>
  </section>

  <section class="contact-card-wrap" aria-labelledby="formulario">
    <div class="container">
      <div class="contact-card" data-reveal>
        <div class="contact-card__map">
          <iframe
            src={site.contact.mapEmbedUrl}
            title={`Mapa de ${site.contact.location}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
          <p class="contact-card__address">
            <svg class="contact-card__pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path></svg>
            <span>{site.contact.address[0]}<br />{site.contact.address[1]}</span>
          </p>
          <a class="contact-card__maplink" href={site.contact.mapUrl} target="_blank" rel="noopener noreferrer">
            Abrir en Google Maps<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
          </a>
        </div>
        <div class="contact-card__form">
          <span class="eyebrow">Contáctanos</span>
          <h2 id="formulario">Escríbenos</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <section class="section info" aria-labelledby="datos">
    <div class="container">
      <h2 id="datos" class="visually-hidden">Datos de contacto</h2>
      {site.contact.provisional && <ProvisionalNote text="Correo y teléfono de ejemplo: reemplazar por los oficiales." />}
      <ul class="info__grid" role="list">
        <li class="info__card" data-reveal style="--stagger:0">
          <a class="info__link" href={`tel:${site.contact.phoneHref}`}>
            <span class="info__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg></span>
            <h3>Llámanos</h3>
            <span class="info__value">{site.contact.phoneDisplay}</span>
          </a>
        </li>
        <li class="info__card" data-reveal style="--stagger:1">
          <a class="info__link" href={`mailto:${site.contact.email}`}>
            <span class="info__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect pathLength="1" x="3" y="5" width="18" height="14" rx="2"></rect><path pathLength="1" d="m3 7 9 6 9-6"></path></svg></span>
            <h3>Escríbenos</h3>
            <span class="info__value">{site.contact.email}</span>
          </a>
        </li>
        <li class="info__card" data-reveal style="--stagger:2">
          <a class="info__link" href={site.contact.mapUrl} target="_blank" rel="noopener noreferrer">
            <span class="info__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle pathLength="1" cx="12" cy="9.5" r="2.5"></circle></svg></span>
            <h3>Visítanos</h3>
            <span class="info__value">{site.contact.address[0]}<br />{site.contact.address[1]}</span>
            <span class="visually-hidden"> (abre el mapa en una pestaña nueva)</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

</BaseLayout>

<script>
  // Preselecciona el motivo cuando el enlace lo indica (?motivo=Otro).
  const motivo = new URLSearchParams(window.location.search).get('motivo');
  const select = document.querySelector<HTMLSelectElement>('#motivo');
  if (motivo && select && Array.from(select.options).some((o) => o.value === motivo)) select.value = motivo;
</script>

<style>
  .contact-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(20rem, 42vw, 28rem);
    padding-bottom: clamp(7rem, 14vw, 10rem);
    overflow: hidden;
    color: #fff;
    text-align: center;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .contact-hero :global(picture),
  .contact-hero :global(.contact-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .contact-hero :global(.contact-hero__img) {
    object-fit: cover;
    object-position: center 40%;
  }

  .contact-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgb(15 59 46 / 0.78);
  }

  .contact-hero__content {
    position: relative;
    padding-top: var(--space-8);
  }

  .contact-hero__title {
    margin: 0;
    color: #fff;
    font-size: clamp(2.75rem, 1.8rem + 4.5vw, 5rem);
    letter-spacing: 0.02em;
    text-shadow: 0 6px 30px rgb(0 0 0 / 0.35);
  }

  .contact-hero__title span {
    display: inline-block;
  }

  /* Íconos de teléfono, correo y ubicación que flotan sobre la portada. */
  .contact-hero__badges {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .badge {
    position: absolute;
    display: grid;
    place-items: center;
    width: clamp(3rem, 6vw, 4.25rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(6px);
  }

  .badge svg {
    width: 45%;
    height: 45%;
    fill: none;
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .badge--phone {
    top: 22%;
    left: 12%;
  }

  .badge--mail {
    top: 14%;
    right: 14%;
  }

  .badge--pin {
    top: 46%;
    right: 24%;
  }

  @media (max-width: 40rem) {
    .badge--pin {
      display: none;
    }

    .badge--phone {
      left: 6%;
    }

    .badge--mail {
      right: 6%;
    }

    /* Bajo la barra de navegación, para no taparla. */
    .badge--phone,
    .badge--mail {
      top: calc(var(--header-h) + 0.5rem);
    }
  }

  /* En los teléfonos más angostos no hay espacio junto al título. */
  @media (max-width: 21.5rem) {
    .contact-hero__badges {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-hero :global(.contact-hero__img) {
      animation: ch-zoom 8s var(--ease-out) both;
    }

    .contact-hero__title span {
      animation: ch-letter 0.9s var(--ease-out) both;
      animation-delay: calc(150ms + var(--i) * 60ms);
    }

    .badge {
      animation:
        ch-pop 0.8s var(--ease-out) backwards,
        ch-float 6s ease-in-out infinite;
    }

    .badge--phone {
      animation-delay: 0.6s, 1.4s;
    }

    .badge--mail {
      animation-delay: 0.8s, 2.2s;
    }

    .badge--pin {
      animation-delay: 1s, 3s;
    }

    .contact-card__map {
      clip-path: inset(0 0 0 0);
    }

    :global(.js) .contact-card:not(.is-visible) .contact-card__map {
      clip-path: inset(0 100% 0 0);
    }

    :global(.js) .contact-card .contact-card__map {
      transition: clip-path 1.2s var(--ease-mask) 0.2s;
    }

    .contact-card__pin {
      animation: pin-drop 1s var(--ease-out) 1.2s backwards, pin-bounce 2.4s ease-in-out 2.2s infinite;
    }
  }

  @keyframes ch-letter {
    from {
      opacity: 0;
      transform: translateY(0.7em) rotate(8deg) scale(0.8);
      filter: blur(6px);
    }
  }

  @keyframes ch-pop {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
  }

  @keyframes ch-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -14px;
    }
  }

  @keyframes pin-drop {
    from {
      opacity: 0;
      transform: translateY(-40px);
    }
  }

  @keyframes pin-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes ch-zoom {
    from {
      transform: scale(1.12);
    }
  }


  /* La tarjeta sube sobre el encabezado, como en el diseño de referencia. */
  .contact-card-wrap {
    position: relative;
    margin-top: calc(-1 * clamp(6rem, 12vw, 8.5rem));
  }

  .contact-card {
    display: grid;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 60rem) {
    .contact-card {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .contact-card__map {
    position: relative;
    min-height: 18rem;
    background: var(--tint-100);
  }

  /* El mapa llena toda la altura de la tarjeta, a la par del formulario. */
  .contact-card__map iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 59.99rem) {
    .contact-card__map {
      min-height: 22rem;
    }
  }

  .contact-card__address {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    display: flex;
    gap: var(--space-3);
    align-items: center;
    max-width: 22rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-card) 95%, transparent);
    box-shadow: var(--shadow-md);
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--color-text);
  }

  .contact-card__pin {
    flex: none;
    width: 2rem;
    height: 2rem;
    fill: var(--ink-accent);
  }

  .contact-card__maplink {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--verde-700);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--shadow-md);
  }

  .contact-card__maplink:hover {
    background: var(--verde-800);
    color: #fff;
  }

  .contact-card__form {
    padding: clamp(var(--space-5), 4vw, var(--space-8));
  }

  .info__grid {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .info__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .info__card {
    border-radius: var(--radius-lg);
  }

  /* El correo es largo: se achica un poco en pantallas angostas para no partirse. */
  .info__link[href^='mailto'] .info__value {
    font-size: clamp(0.82rem, 0.6rem + 1.2vw, 1rem);
    overflow-wrap: anywhere;
  }

  .info__link {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6) var(--space-4);
    overflow: hidden;
    text-align: center;
    border-radius: inherit;
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      color 0.35s var(--ease);
  }

  /* Relleno verde que sube al pasar el cursor. */
  .info__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(150deg, var(--verde-900), var(--verde-700) 60%, var(--turquesa-700));
    transform: translateY(101%);
    transition: transform 0.55s var(--ease-out);
  }

  .info__link:hover,
  .info__link:focus-visible {
    transform: translateY(-8px);
    box-shadow: 0 22px 40px -22px rgb(15 59 46 / 0.55);
    color: #e6f4ec;
  }

  .info__link:hover::before,
  .info__link:focus-visible::before {
    transform: none;
  }

  .info__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--color-card);
    box-shadow: 0 8px 20px -10px rgb(15 59 46 / 0.4);
    transition: transform 0.45s var(--ease-out);
  }

  /* Onda que se expande desde el ícono. */
  .info__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--brand-verde);
    border-radius: 50%;
    opacity: 0;
  }

  .info__icon svg {
    width: 2.25rem;
    height: 2.25rem;
    fill: none;
    stroke: var(--ink-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .info__link:hover .info__icon,
  .info__link:focus-visible .info__icon {
    transform: scale(1.08) rotate(-6deg);
  }

  .info__card h3 {
    margin: 0;
    font-size: var(--fs-md);
    color: inherit;
  }

  .info__link h3 {
    color: var(--color-heading);
    transition: color 0.35s var(--ease);
  }

  .info__link:hover h3,
  .info__link:focus-visible h3 {
    color: #fff;
  }

  .info__value {
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.35s var(--ease);
  }

  .info__link:hover .info__value {
    text-decoration-color: currentColor;
  }

  .info__link:focus-visible {
    outline: 3px solid var(--brand-lima);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .info__card .info__icon svg > * {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js) .info__card:global(.is-visible) .info__icon svg > * {
      animation: draw 1.3s var(--ease-out) forwards;
      animation-delay: calc(300ms + var(--stagger, 0) * 150ms);
    }

    .info__link:hover .info__icon::after {
      animation: ring 1.2s var(--ease-out) infinite;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes ring {
    from {
      opacity: 0.8;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }
</style>
